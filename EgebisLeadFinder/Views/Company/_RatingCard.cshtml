@model RatingViewModel
@{
    // Faz-II: firma on arastirma / rating karti. Model null ise firma henuz arastirilmadi.
    var companyId = (int)(ViewData["CompanyId"] ?? 0);
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span>Firma Durumu — Ön Araştırma</span>
        @if (Model is not null)
        {
            <form method="post" asp-action="Research" asp-route-id="@companyId" class="research-form m-0"
                  data-progress-start="@Url.Action("StartResearch", new { id = companyId })"
                  data-progress-title="Firma ön araştırması ve finansal analizi"
                  data-progress-hint="Haber, KAP ve resmi kayıt kaynakları taranıp yapay zeka ile değerlendiriliyor.">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-secondary research-button" type="submit">
                    Yeniden Araştır
                </button>
                @* Gun icinde tekrar arastirma kredi harcar; "zorla" bilerek secilir. *@
                <button class="btn btn-sm btn-link text-muted-2 px-1 research-button" type="submit"
                        name="force" value="true" title="Bugün araştırılmış olsa bile baştan araştır">
                    zorla
                </button>
            </form>
        }
    </div>

    @if (Model is null)
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
                    <circle cx="12" cy="12" r="4" />
                </svg>
            </div>
            <div class="empty-title">Bu firma henüz araştırılmadı</div>
            <div class="mb-3">
                Ücretsiz kaynaklardan (haber, KAP, resmi kayıt linkleri) firmanın ticari ve
                finansal sağlık durumu için bir sinyal üretilir. Lead puanından bağımsızdır.
            </div>
            <form method="post" asp-action="Research" asp-route-id="@companyId" class="research-form"
                  data-progress-start="@Url.Action("StartResearch", new { id = companyId })"
                  data-progress-title="Firma ön araştırması ve finansal analizi"
                  data-progress-hint="Haber, KAP ve resmi kayıt kaynakları taranıp yapay zeka ile değerlendiriliyor.">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary btn-sm research-button" type="submit">Ön Araştırma Yap</button>
            </form>
        </div>
    }
    else
    {
        var r = Model.Rating;

        <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <span class="signal-badge @Model.SignalCss">
                    <span class="signal-dot"></span> @Model.SignalLabel
                </span>
                @if (Model.RatedAt is not null)
                {
                    <span class="cell-sub">
                        Son araştırma: @Model.RatedAt.Value.ToLocalTime().ToString("d MMMM yyyy HH:mm")
                    </span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(r.Summary))
            {
                <p class="mb-3">@r.Summary</p>
            }

            <div class="table-responsive">
                <table class="table table-sm rating-table mb-0">
                    <tbody>
                        <tr>
                            <th>Şirket</th>
                            <td>@Fallback(r.FoundingInfo)</td>
                        </tr>
                        <tr>
                            <th>Ölçek</th>
                            <td>@Fallback(r.ScaleInfo)</td>
                        </tr>
                        <tr>
                            <th>Finansal durum</th>
                            <td>
                                @Fallback(r.FinancialInfo)
                                @if (r.HasFinancialData)
                                {
                                    <span class="tag tag-muted ms-1">kaynak: @r.FinancialSource</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ortaklar / yöneticiler</th>
                            <td>@Fallback(r.Owners)</td>
                        </tr>
                        <tr>
                            <th>Müşteriler</th>
                            <td>@ListOrDash(r.Customers)</td>
                        </tr>
                        <tr>
                            <th>Tedarikçiler</th>
                            <td>@ListOrDash(r.Suppliers)</td>
                        </tr>
                        <tr>
                            <th>Projeler</th>
                            <td>@ListOrDash(r.Projects)</td>
                        </tr>
                        <tr>
                            <th>Risk sinyalleri</th>
                            <td>
                                @if (r.RiskSignals.Count == 0)
                                {
                                    <span class="text-success">Risk işareti bulunamadı</span>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var risk in r.RiskSignals)
                                        {
                                            <li class="mb-1">
                                                <span class="tag @RiskCss(risk.Severity)">@risk.Severity</span>
                                                @risk.Text
                                                @if (!string.IsNullOrWhiteSpace(risk.SourceUrl))
                                                {
                                                    <a href="@risk.SourceUrl" target="_blank" rel="noopener noreferrer"
                                                       class="small ms-1">kaynak</a>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Büyüme</th>
                            <td>@ListOrDash(r.GrowthSignals)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (r.EvaluatorNotes.Count > 0)
            {
                <div class="mt-3">
                    <div class="stat-label mb-1">Sinyal gerekçesi</div>
                    <ul class="mb-0 small text-muted-2">
                        @foreach (var note in r.EvaluatorNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }

            @if (r.CheckedSources.Count > 0)
            {
                <div class="mt-3">
                    <div class="stat-label mb-1">Kontrol edilen kaynaklar</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var src in r.CheckedSources)
                        {
                            <span class="tag @(src.FoundSomething ? "tag-success" : "tag-muted")">
                                @src.Name @(src.FoundSomething ? "✓" : "—")
                            </span>
                        }
                    </div>
                </div>
            }

            @if (r.RegistryLinks.Count > 0)
            {
                <div class="mt-3">
                    <div class="stat-label mb-1">Resmi kaynakları kendiniz açın</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var link in r.RegistryLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-secondary">@link.Label ↗</a>
                        }
                    </div>
                </div>
            }

            <div class="alert alert-warning small mt-3 mb-0" data-flash="info" data-flash-title="Ön araştırma hakkında" data-flash-timeout="7000">
                Bu değerlendirme kamuya açık kaynaklardan
                otomatik derlenmiştir; kesin bir finansal analiz değildir. Kritik kararlar öncesi
                Findeks gibi ticari istihbarat raporlarıyla veya resmi kayıtlarla doğrulayın.
            </div>
        </div>
    }
</div>

@functions {
    static string Fallback(string? value) =>
        string.IsNullOrWhiteSpace(value) || value.Equals("bilinmiyor", StringComparison.OrdinalIgnoreCase)
            ? "—"
            : value;

    static string ListOrDash(List<string> items) =>
        items is { Count: > 0 } ? string.Join(", ", items) : "—";

    static string RiskCss(string? severity) => severity?.ToLowerInvariant() switch
    {
        "yuksek" => "tag-danger",
        "orta" => "tag-amber",
        _ => "tag-muted"
    };
}
