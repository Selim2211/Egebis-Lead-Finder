@model CompanySearchViewModel
@using EgebisLeadFinder.Data
@inject EgebisLeadFinder.Services.ISettingsService SearchSettings
@{
    ViewData["Title"] = "Firma Ara";

    var sellerProfile = EgebisLeadFinder.Services.BusinessProfileService
        .Parse(await SearchSettings.GetAsync(SettingKeys.BusinessProfile));
    var profileReady = sellerProfile.IsConfigured;
    var me = EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.UserId(User);
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
    var selectedId = Model.Criteria.ProfileId;
    var defaultProfile = Model.DefaultProfile;
}

@if (!profileReady)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <div class="flex-grow-1">
            <strong>Şirket profiliniz tanımlı değil.</strong> Firma araması, yapay zekâ analizi ve mail önerileri şu an
            varsayılan tanımla (SAP/üretim yazılımı) çalışıyor. Kendi işinize göre çalışması için “Şirketimiz” ekranını doldurun.
        </div>
        @if (isAdmin)
        {
            <a class="btn btn-sm btn-accent" asp-controller="BusinessProfile" asp-action="Index">Şirketimiz</a>
        }
        else
        {
            <span class="small">Yöneticinizden doldurmasını isteyin.</span>
        }
    </div>
}

<div class="page-head">
    <div>
        <h1>Firma Ara</h1>
        <div class="page-sub">Arama profili seçin, firmaları keşfedin ve yapay zeka ile değerlendirin</div>
    </div>
</div>

<form method="post" asp-action="Search" class="name-search mb-4" id="nameSearchForm"
      data-progress-start="@Url.Action("StartSearch")"
      data-progress-title="Firma aranıyor"
      data-progress-hint="Firmanın resmi sitesi bulunup yapay zeka ile değerlendiriliyor.">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SubmitMode" value="@CompanySearchViewModel.ModeCompany" />

    <div class="name-search-frame">
        <div class="name-search-inner">
            <span class="name-search-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4" /><path d="M9 9v.01M9 12v.01M9 15v.01M9 18v.01" />
                </svg>
            </span>
            <div class="name-search-field">
                <label class="name-search-label" for="companyNameInput">Belirli bir firmayı bul</label>
                <input class="name-search-input" id="companyNameInput" name="Criteria.CompanyName"
                       value="@Model.Criteria.CompanyName" placeholder="Firma adı yazın — ör. Toyota, Egebis, Arçelik"
                       autocomplete="off" maxlength="150" required disabled="@(defaultProfile is null ? "disabled" : null)" />
            </div>
            <button type="submit" class="name-search-button" disabled="@(defaultProfile is null ? "disabled" : null)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                </svg>
                <span>Firmayı Bul</span>
            </button>
        </div>
    </div>
    <div class="name-search-hint">
        @if (defaultProfile is null)
        {
            <span>Firma adıyla aramak için <a asp-controller="SearchProfiles" asp-action="Index">Arama Profilleri</a> ekranından varsayılan profil seçin.</span>
        }
        else
        {
            <span>Varsayılan profil: <strong>@defaultProfile.Name</strong> (<a asp-controller="SearchProfiles" asp-action="Index">değiştir</a>)</span>
        }
    </div>
</form>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Arama</div>
            <div class="card-body">
                <form method="post" id="searchForm" asp-action="Search"
                      data-progress-start="@Url.Action("StartSearch")"
                      data-progress-title="Firma araştırması yapılıyor"
                      data-progress-hint="Her firmanın sitesi okunup yapay zeka ile değerlendiriliyor. Bu birkaç dakika sürebilir; sayfayı kapatmayın.">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SubmitMode" value="@CompanySearchViewModel.ModeProfile" />

                    <label class="form-label" for="profileSelect">Arama profili *</label>
                    <div class="profile-pick mb-3">
                        <select class="form-select" id="profileSelect" name="Criteria.ProfileId" required>
                            <option value="" selected="@(selectedId is null)">Profil seçin</option>
                            @foreach (var p in Model.Profiles)
                            {
                                var dto = SearchProfileDto.From(p, me, isAdmin);
                                <option value="@p.Id" selected="@(selectedId == p.Id)" data-profile="@dto.ToJson()">
                                    @p.Name — @dto.RegionName
                                </option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary text-nowrap" id="profileShow" data-profile-show>Göster</button>
                        <button type="button" class="btn btn-outline-primary text-nowrap" data-profile-new>Yeni Arama Profili</button>
                    </div>

                    <button type="submit" class="btn btn-accent w-100" id="searchButton">Aramayı Başlat</button>
                </form>
            </div>
        </div>

        @* Bilgi notu sabit yazi: eskiden her sayfa acilisinda bildirim olarak cikiyordu. *@
        <p class="small text-muted-2 mt-3 mb-0">
            Arama birkaç dakika sürebilir: her firmanın sitesi okunup yapay zeka ile değerlendirilir.
            İsterseniz ilerleme ekranından aramayı iptal edebilirsiniz.
        </p>
    </div>

    <div class="col-lg-7">
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger" data-flash="error" data-flash-title="Arama tamamlanamadı" data-flash-timeout="12000">

                @Model.Error
            </div>
        }

        @if (Model.Result is not null)
        {
            var result = Model.Result;
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Arama sonucu</span>
                    @if (result.ProfileName is not null)
                    {
                        <span class="tag tag-muted">Profil: @result.ProfileName</span>
                    }
                </div>
                <div class="card-body">
                    @if (result.Cancelled)
                    {
                        <div class="alert alert-secondary py-2 small">
                            <strong>Arama iptal edildi.</strong> O ana kadar işlenen @result.Processed firma kaydedildi@(result.SkippedByQuota > 0 ? $", {result.SkippedByQuota} firma işlenmedi" : "").
                        </div>
                    }
                    @if (result.AbortReason is not null)
                    {
                        <div class="alert alert-warning py-2 small">
                            <strong>Arama tamamlanamadı:</strong> @result.AbortReason
                            @if (result.SkippedByQuota > 0)
                            {
                                <span> @result.SkippedByQuota firma incelenemedi; kota yenilenince aramayı tekrar çalıştırın.</span>
                            }
                        </div>
                    }
                    @if (result.Warning is not null)
                    {
                        <div class="alert alert-warning py-2 small">@result.Warning</div>
                    }
                    <div class="row text-center g-3 mb-4">
                        <div class="col">
                            <div class="stat-value" style="font-size:1.7rem">@result.FoundBySearch</div>
                            <div class="stat-label">bulundu</div>
                        </div>
                        <div class="col">
                            <div class="stat-value" style="font-size:1.7rem">@result.Processed</div>
                            <div class="stat-label">işlendi</div>
                        </div>
                        <div class="col">
                            <div class="stat-value" style="font-size:1.7rem">@result.AlreadyKnown</div>
                            <div class="stat-label">zaten kayıtlı</div>
                        </div>
                        <div class="col">
                            <div class="stat-value @(result.Failed > 0 ? "text-warning" : "")"
                                 style="font-size:1.7rem">@result.Failed</div>
                            <div class="stat-label">hatalı</div>
                        </div>
                        @if (result.PreFiltered.Count > 0)
                        {
                            <div class="col">
                                <div class="stat-value" style="font-size:1.7rem">@result.PreFiltered.Count</div>
                                <div class="stat-label">ön elemede elendi</div>
                            </div>
                        }
                    </div>

                    @if (result.SerperCredits > 0 || result.AiCalls > 0)
                    {
                        <div class="small text-muted-2 mb-3" title="Önbellekten dönen sorgular kredi harcamaz">
                            Bu aramanın harcadığı: <strong>@result.SerperCredits</strong> Serper kredisi · <strong>@result.AiCalls</strong> yapay zekâ çağrısı
                        </div>
                    }
                    @if (result.SearchTerms.Count > 1)
                    {
                        <div class="search-terms mb-3">
                            <span class="search-terms-label">Arama terimleri</span>
                            @foreach (var term in result.SearchTerms)
                            {
                                <span class="tag tag-muted">@term</span>
                            }
                        </div>
                    }

                    @if (result.Companies.Count == 0 && result.AbortReason is null && !result.Cancelled)
                    {
                        @if (result.NaceFiltered > 0)
                        {
                            <p class="text-muted-2 mb-0">
                                Bulunan firmaların hiçbiri seçilen ürünleri üretmiyor. Arama profilinde firma sayısını artırın ya da ürün seçimini değiştirip tekrar deneyin.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted-2 mb-0">
                                Sonuç bulunamadı. Arama profilinde sektör veya ili değiştirip tekrar deneyin.
                            </p>
                        }
                    }
                </div>

                @if (result.Companies.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width:6rem">Skor</th>
                                    <th>Firma</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var company in result.Companies)
                            {
                                <tr>
                                    <td><partial name="_CompanyScore" model="company" /></td>
                                    <td>
                                        <div class="cell-title">
                                            @company.Name
                                            @if (result.NewCompanyIds.Contains(company.Id))
                                            {
                                                <span class="tag tag-success run-tag">yeni</span>
                                            }
                                            @if (result.FirmKinds.TryGetValue(company.Id, out var firmKind))
                                            {
                                                @switch (firmKind)
                                                {
                                                    case FirmKind.Producer:
                                                        <span class="tag tag-success run-tag" title="Üretici olduğu sitesinden alınan cümleyle kanıtlandı">Üretici</span>
                                                        break;
                                                    case FirmKind.Contract:
                                                        <span class="tag tag-info run-tag" title="Başkaları için fason üretim yapıyor">Fason üretici</span>
                                                        break;
                                                    default:
                                                        <span class="tag tag-muted run-tag" title="Üretici gibi duruyor ama sitesinden gösterilebilir bir kanıt bulunamadı">Emin değil</span>
                                                        break;
                                                }
                                            }
                                        </div>
                                        @if (result.ProductMatches.TryGetValue(company.Id, out var made))
                                        {
                                            <div class="cell-sub nace-made">Üretiyor: @string.Join(", ", made)</div>
                                        }
                                        @if (result.ProducerProof.TryGetValue(company.Id, out var proofQuote))
                                        {
                                            <div class="cell-sub text-muted" title="Firmanın kendi sitesinden alınan cümle">Kanıt: «@proofQuote»</div>
                                        }
                                        <div class="cell-sub">
                                            @company.Domain
                                            @if (company.EvaluationStatus == EvaluationStatus.NotEvaluated && company.EvaluationNote is not null)
                                            {
                                                <span class="text-warning">• @company.EvaluationNote</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <partial name="_FavoriteStar" model="new FavoriteStar(company.Id, Model.FavoriteIds.Contains(company.Id))" />
                                        <a class="btn btn-sm btn-outline-primary ms-1"
                                           asp-action="Details" asp-route-id="@company.Id">İncele</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (result.PreFiltered.Count > 0)
                {
                    <details class="prefilter-list">
                        <summary>Siteye girmeden elenen @result.PreFiltered.Count aday — neden elendiklerini gör</summary>
                        <div class="small text-muted-2 mb-2">
                            Bu adayların siteleri okunmadı, kayıt açılmadı. Yanlışlıkla elenen bir firma varsa üstteki "Belirli bir firmayı bul" ile adıyla arayabilirsiniz.
                        </div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var d in result.PreFiltered)
                            {
                                <li>
                                    <span class="fw-semibold">@d.Title</span>
                                    <a class="small" href="https://@d.Domain" target="_blank" rel="noopener noreferrer">@d.Domain</a>
                                    <span class="text-muted-2 small">— @d.Reason</span>
                                    <span class="tag tag-muted run-tag">@d.Stage</span>
                                </li>
                            }
                        </ul>
                    </details>
                }

                @if (result.RunId is not null && result.Companies.Count > 0)
                {
                    <div class="card-footer d-flex flex-wrap align-items-center gap-2">
                        <a class="btn btn-accent" asp-action="Index" asp-route-run="@result.RunId">Bu aramanın sonuçlarını Firmalar'da gör</a>
                        @if (result.ProfileName is not null)
                        {
                            <span class="small text-muted-2">Bulunan firmalar "@result.ProfileName" profiline otomatik eklendi.</span>
                        }
                    </div>
                }
            </div>
        }
        else if (Model.Error is null)
        {
            <div class="card">
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                        </svg>
                    </div>
                    <div class="empty-title">Sonuçlar burada görünecek</div>
                    <div>Soldan bir arama profili seçip aramayı başlatın.</div>
                </div>
            </div>
        }
    </div>
</div>

<partial name="_SearchProfileModal" model="@(new SearchProfileModalModel(Model.Region, Model.MaxCompanies, Model.Result is null ? Model.Criteria.Industry : null))" />

@section Scripts {
<partial name="_SearchProfileModalScript" />
<script>
    (function () {
        var form = document.getElementById('searchForm');
        var button = document.getElementById('searchButton');
        var select = document.getElementById('profileSelect');
        var show = document.getElementById('profileShow');

        // Goster dugmesi secili profilin detayini acar; profil secilmeden arama baslatilamaz.
        function refresh() {
            var option = select.options[select.selectedIndex];
            var raw = option ? option.getAttribute('data-profile') : null;
            if (raw) show.setAttribute('data-profile', raw); else show.removeAttribute('data-profile');
            show.disabled = !raw;
            button.disabled = !select.value;
        }
        select.addEventListener('change', refresh);
        refresh();

        // Yeni kaydedilen profil listeye eklenir ve secili olur.
        document.addEventListener('searchprofile:saved', function (e) {
            var p = e.detail;
            var option = select.querySelector('option[value="' + p.id + '"]');
            if (!option) {
                option = document.createElement('option');
                option.value = p.id;
                select.insertBefore(option, select.options[1] || null);
            }
            option.textContent = p.name + ' — ' + p.regionName;
            option.setAttribute('data-profile', JSON.stringify(p));
            select.value = p.id;
            refresh();
        });

        form.addEventListener('submit', function (e) {
            if (!select.value) { e.preventDefault(); select.focus(); return; }
            if (window.EgebisProgress) return; // overlay bekleme durumunu yonetir
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Aranıyor...';
        });
    })();
</script>
}
