@model AuditListViewModel
@using EgebisLeadFinder.Controllers
@{
    ViewData["Title"] = "Audit log";
    var req = Context.Request;
    string ExportUrl() => "/Audit/Export" + req.QueryString;
}

<div class="page-head">
    <div>
        <h1>Audit log</h1>
        <div class="page-sub">Girişler, çıkışlar ve uygulamadaki tüm işlemler. Şifre ve API anahtarı gibi gizli değerler kaydedilmez.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="@ExportUrl()">CSV indir</a>
        <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small" for="from">Başlangıç</label>
            <input class="form-control form-control-sm" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="to">Bitiş</label>
            <input class="form-control form-control-sm" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="userId">Kullanıcı</label>
            <select class="form-select form-select-sm" id="userId" name="userId">
                <option value="">Herkes</option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.Id" selected="@(Model.UserId == u.Id)">@u.UserName</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="op">İşlem</label>
            <select class="form-select form-select-sm" id="op" name="op">
                <option value="">Tümü</option>
                @foreach (var (code, label) in Model.Actions.OrderBy(a => a.Label))
                {
                    <option value="@code" selected="@(Model.Action == code)">@label</option>
                }
            </select>
        </div>
        <div class="col-8 col-md-2">
            <label class="form-label small" for="q">Ara</label>
            <input class="form-control form-control-sm" id="q" name="q" value="@Model.Q" placeholder="özet, kullanıcı, IP" />
        </div>
        <div class="col-4 col-md-2 d-flex flex-column gap-1">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="onlyFailed" name="onlyFailed" value="true" checked="@Model.OnlyFailed" />
                <label class="form-check-label small" for="onlyFailed">Sadece başarısız</label>
            </div>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-primary flex-grow-1" type="submit">Filtrele</button>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Temizle">×</a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover audit-table mb-0">
            <thead>
                <tr>
                    <th style="width:9.5rem">Tarih</th>
                    <th style="width:9rem">Kullanıcı</th>
                    <th style="width:13rem">İşlem</th>
                    <th>Özet</th>
                    <th style="width:8rem">IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted-2 py-4">Kayıt yok.</td></tr>
                }
                @foreach (var a in Model.Entries)
                {
                    <tr class="@(a.Success ? "" : "audit-failed")">
                        <td class="text-nowrap small">@a.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="small">
                            @if (a.UserId is not null)
                            {
                                <a asp-action="Index" asp-route-userId="@a.UserId">@a.UserName</a>
                            }
                            else
                            {
                                <span class="text-muted-2">@a.UserName</span>
                            }
                        </td>
                        <td class="small">
                            @if (!a.Success) { <span class="tag tag-danger me-1">başarısız</span> }
                            @AuditController.ActionLabel(a.Action)
                        </td>
                        <td class="small">@a.Summary</td>
                        <td class="small text-muted-2" title="@a.UserAgent">@a.Ip</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model.Pager" />
