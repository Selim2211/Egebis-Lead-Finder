@model BusinessProfileForm
@using EgebisLeadFinder.Data
@{
    ViewData["Title"] = "Şirketimiz";
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
}

<div class="page-head">
    <div>
        <h1>Şirketimiz</h1>
        <div class="page-sub">Şirketinizi ve hedef müşterinizi tanıtın; yapay zekâ bulduğu firmaları bu tanıma göre değerlendirir, mailleri buna göre yazar</div>
    </div>
    @if (Model.UpdatedAt is DateTime updated)
    {
        <div class="small text-muted-2 text-end">
            Son güncelleme: @updated.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@(Model.UpdatedBy is null ? "" : " · " + Model.UpdatedBy)
        </div>
    }
</div>

@if (TempData["ProfileSaved"] is string saved)
{
    <div class="alert alert-success" data-flash="success">@saved</div>
}

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">
        <strong>Şirket profili henüz tanımlı değil.</strong>
        Şu an yapay zekâ varsayılan (Egebis — SAP/MES) tanımıyla çalışıyor.
        @if (isAdmin)
        {
            <span>Aşağıya sitenizin adresini yazıp <strong>Sitemizden doldur</strong> deyin, taslağı düzeltip kaydedin.</span>
        }
        else
        {
            <span>Tanımı yönetici yapabilir.</span>
        }
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (isAdmin)
{
    <div class="card bp-autofill mb-4">
        <div class="card-body">
            <div class="bp-autofill-row">
                <div class="bp-autofill-text">
                    <div class="fw-semibold d-flex align-items-center gap-2">@Icons.Sparkles(16) Sitemizden otomatik doldur</div>
                    <div class="small text-muted-2">Yapay zekâ sitenizi okur; ne sattığınızı, ideal müşterinizi ve hedef unvanları taslak olarak doldurur. Kaydetmeden önce düzeltebilirsiniz.</div>
                </div>
                <form class="bp-autofill-form" id="draftForm" asp-action="Draft" method="post">
                    @Html.AntiForgeryToken()
                    <input class="form-control" name="website" id="draftWebsite" value="@Model.Website"
                           placeholder="ornek.com" autocomplete="off" maxlength="300" required />
                    <button type="submit" class="btn btn-accent text-nowrap" id="draftButton">Sitemizden doldur</button>
                </form>
            </div>
            <div class="small mt-2" id="draftStatus" role="status"></div>
        </div>
    </div>
}

<form method="post" asp-action="Index" id="profileForm">
    @Html.AntiForgeryToken()
    <fieldset disabled="@(!isAdmin)">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card mb-4">
                    <div class="card-header">Şirket bilgileri</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="CompanyName">Şirket adı</label>
                                <input class="form-control" asp-for="CompanyName" maxlength="150" placeholder="Egebis Bilişim" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Website">Web sitesi</label>
                                <input class="form-control" asp-for="Website" maxlength="300" placeholder="egebis.com" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="Offering">Ne satıyoruz? *</label>
                                <textarea class="form-control" asp-for="Offering" rows="3" maxlength="2000"
                                          placeholder="Üretici firmalara SAP danışmanlığı, SAP entegrasyonu, MES/üretim takip yazılımı"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="ProblemsWeSolve">Hangi sorunu çözüyoruz?</label>
                                <textarea class="form-control" asp-for="ProblemsWeSolve" rows="2" maxlength="2000"
                                          placeholder="Üretim planlama, stok ve maliyet takibi, sistemler arası entegrasyon"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="IdealCustomer">İdeal müşterimiz *</label>
                                <textarea class="form-control" asp-for="IdealCustomer" rows="3" maxlength="2000"
                                          placeholder="50-1000 çalışanlı, kendi üretimini yapan fabrikalar; SAP kullanan veya ERP'ye geçecek firmalar"></textarea>
                                <div class="form-text">Ne kadar somut olursa (sektör, büyüklük, özellik) firmalar o kadar isabetli elenir.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="NotCustomers">Kimler müşterimiz DEĞİL</label>
                                <textarea class="form-control" asp-for="NotCustomers" rows="3" maxlength="2000"
                                          placeholder="Bayi, distribütör, perakende, dernek, haber sitesi"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Competitors">Rakiplerimiz</label>
                                <textarea class="form-control" asp-for="Competitors" rows="3" maxlength="2000"
                                          placeholder="SAP danışmanlık firmaları, ERP yazılım evleri"></textarea>
                                <div class="form-text">Rakip çıkan firmalar "Elendi" olur.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="ExampleCustomers">Örnek mevcut müşteriler</label>
                                <input class="form-control" asp-for="ExampleCustomers" placeholder="Firma adı veya sitesi, virgülle ayırın" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="CustomerKind">Müşterilerimiz ne tür firmalar?</label>
                                <select class="form-select" asp-for="CustomerKind">
                                    <option value="">Otomatik (tanıma göre)</option>
                                    <option value="@BusinessProfile.KindManufacturer">Üretici firmalar</option>
                                    <option value="@BusinessProfile.KindAny">Her tür şirket</option>
                                </select>
                                <div class="form-text">Üretici: fabrika, imalat. Her tür şirket: ticaret, hizmet, inşaat, kurum… Firma araması buna göre “üreticileri / fabrikası” ya da “firmaları / şirketleri” diye yapılır.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="BuyingSignals">İhtiyaç sinyalleri</label>
                                <input class="form-control" asp-for="BuyingSignals" placeholder="yeni fabrika, kapasite artışı, tesisat projesi, ihale" />
                                <div class="form-text">Bir firmanın size ihtiyacı olduğunu gösteren ifadeler. Firma araştırmasında haberler bunlarla taranır, fırsatlar bunlara göre önerilir.</div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <label class="form-label mb-0" for="ScoringSignals">Puanlama anahtar kelimeleri</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="suggestSignals" data-url="@Url.Action("SuggestSignals")">
                                        Yapay zekâ ile öner
                                    </button>
                                </div>
                                @* Asil deger gizli alanda: sunucu "Ad | kelime, kelime | puan" satirlarini okur; satirlari asagidaki editor yazar. *@
                                <textarea asp-for="ScoringSignals" class="d-none" id="ScoringSignals"></textarea>
                                <div class="sig-editor mt-2" id="sigEditor">
                                    <div class="sig-row sig-head">
                                        <div>Ölçüt adı</div>
                                        <div>Kelimeler (virgülle ayırın)</div>
                                        <div>Puan</div>
                                        <div></div>
                                    </div>
                                    <div id="sigRows"></div>
                                    <div class="sig-empty text-muted-2 small d-none" id="sigEmpty">Henüz ölçüt yok. "Ölçüt ekle"ye basın.</div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <button type="button" class="btn btn-sm btn-primary" id="sigAdd">+ Ölçüt ekle</button>
                                    <span class="small text-muted-2" id="sigCount"></span>
                                </div>
                                <div class="form-text">
                                    Her satır bir ölçüttür. Firma bu kelimelerden birine uyuyorsa puan alır ve puan dökümünde
                                    “Anahtar kelime: Ölçüt adı” olarak görünür (puan 3-20, en fazla 12 ölçüt). Hücreye tıklayıp doğrudan düzenleyin.
                                    Boş bırakırsanız yapay zekâ tanımınızdan üretir.
                                </div>
                                <div class="small mt-1" id="signalsStatus"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card mb-4">
                    <div class="card-header">Kime ulaşalım?</div>
                    <div class="card-body">
                        <label class="form-label" for="TargetTitles">Hedef unvanlar</label>
                        <textarea class="form-control" asp-for="TargetTitles" rows="4"
                                  placeholder="Genel Müdür, IT Müdürü, CIO, Üretim Müdürü"></textarea>
                        <div class="form-text">Apollo ve site taramasında bu unvanlardaki kişiler aranır (Ayarlar'daki "lead unvanları" ile aynı liste). Virgülle ayırın. <strong>Boş bırakırsanız firmadaki tüm kişiler getirilir.</strong></div>
                    </div>
                </div>

                <div class="card bp-help mb-4">
                    <div class="card-body small">
                        <div class="fw-semibold mb-1">Bu tanım nerede kullanılır?</div>
                        <ul class="mb-0 ps-3">
                            <li>Firma analizinde: firma <em>ideal müşterimize</em> uyuyor mu, rakip mi, neden uygun?</li>
                            <li>Detaylı araştırma raporunda: bizim için satış fırsatları.</li>
                            <li>Yapay zekâ ile yazılan maillerde: gönderen şirket ve anlatılan hizmet.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="bp-actions">
                <button type="submit" class="btn btn-accent px-4">Kaydet</button>
            </div>
        }
    </fieldset>
</form>

@section Scripts {
<style>
    .sig-editor { border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .5rem; overflow: hidden; }
    .sig-row { display: grid; grid-template-columns: 1.2fr 2fr 5.5rem 2.5rem; align-items: stretch; border-top: 1px solid var(--bs-border-color, #dee2e6); }
    .sig-row > div { border-left: 1px solid var(--bs-border-color, #dee2e6); padding: 0; min-width: 0; }
    .sig-row > div:first-child { border-left: 0; }
    .sig-head { background: var(--bs-tertiary-bg, #f1f3f5); font-size: .78rem; font-weight: 600; border-top: 0; }
    .sig-head > div { padding: .35rem .6rem; }
    .sig-row input.sig-cell { width: 100%; border: 0; border-radius: 0; background: transparent; padding: .45rem .6rem; box-shadow: none; }
    .sig-row input.sig-cell:focus { outline: 2px solid var(--bs-primary, #0d6efd); outline-offset: -2px; background: var(--bs-body-bg, #fff); }
    .sig-row input.sig-points { text-align: center; font-weight: 600; }
    .sig-del { width: 100%; height: 100%; border: 0; background: transparent; color: #b42318; font-size: 1.1rem; line-height: 1; cursor: pointer; }
    .sig-del:hover { background: #fef3f2; }
    .sig-empty { padding: .75rem; }
    @@media (max-width: 575.98px) { .sig-row { grid-template-columns: 1fr 4.5rem 2.2rem; } .sig-row > div:nth-child(2) { grid-column: 1 / -1; grid-row: 2; border-left: 0; border-top: 1px solid var(--bs-border-color, #dee2e6); } .sig-head > div:nth-child(2) { display: none; } }
</style>
<script>
    (function () {
        var store = document.getElementById('ScoringSignals');
        var rowsEl = document.getElementById('sigRows');
        if (!store || !rowsEl) return;
        var MAX = 12, MIN_P = 3, MAX_P = 20;
        var emptyEl = document.getElementById('sigEmpty');
        var countEl = document.getElementById('sigCount');
        var addBtn = document.getElementById('sigAdd');

        function clean(v) { return (v || '').replace(/[|\r\n]+/g, ' ').trim(); }

        function serialize() {
            var lines = [];
            rowsEl.querySelectorAll('.sig-row').forEach(function (row) {
                var name = clean(row.querySelector('[data-f=name]').value);
                var terms = clean(row.querySelector('[data-f=terms]').value);
                var pts = parseInt(row.querySelector('[data-f=points]').value, 10);
                if (!name && terms) name = terms.split(',')[0].trim();
                if (!name) return;
                if (isNaN(pts)) pts = 10;
                pts = Math.min(MAX_P, Math.max(MIN_P, pts));
                lines.push(name + ' | ' + terms + ' | ' + pts);
            });
            store.value = lines.join('\n');
        }

        function refresh() {
            var n = rowsEl.children.length;
            emptyEl.classList.toggle('d-none', n > 0);
            countEl.textContent = n + ' / ' + MAX;
            if (addBtn) addBtn.disabled = n >= MAX || addBtn.closest('fieldset[disabled]') !== null;
        }

        function addRow(name, terms, points) {
            if (rowsEl.children.length >= MAX) return null;
            var row = document.createElement('div');
            row.className = 'sig-row';
            function cell(field, type, value, placeholder, cls) {
                var d = document.createElement('div');
                var i = document.createElement('input');
                i.type = type; i.value = value; i.className = 'form-control sig-cell ' + (cls || '');
                i.setAttribute('data-f', field); i.placeholder = placeholder;
                if (type === 'number') { i.min = MIN_P; i.max = MAX_P; i.step = 1; }
                else i.maxLength = field === 'name' ? 80 : 300;
                i.addEventListener('input', serialize);
                i.addEventListener('blur', function () {
                    if (field === 'points') {
                        var p = parseInt(i.value, 10);
                        i.value = isNaN(p) ? 10 : Math.min(MAX_P, Math.max(MIN_P, p));
                        serialize();
                    }
                });
                d.appendChild(i);
                return d;
            }
            row.appendChild(cell('name', 'text', name || '', 'Örn. Üretim yapıyor'));
            row.appendChild(cell('terms', 'text', terms || '', 'fabrika, imalat, üretim tesisi'));
            row.appendChild(cell('points', 'number', points || 10, '10', 'sig-points'));
            var del = document.createElement('div');
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'sig-del'; b.title = 'Bu ölçütü sil'; b.setAttribute('aria-label', 'Bu ölçütü sil'); b.textContent = '×';
            b.addEventListener('click', function () { row.remove(); serialize(); refresh(); });
            del.appendChild(b); row.appendChild(del);
            rowsEl.appendChild(row);
            return row;
        }

        function load() {
            rowsEl.innerHTML = '';
            (store.value || '').split('\n').forEach(function (line) {
                if (!line.trim()) return;
                var p = line.split('|').map(function (x) { return x.trim(); });
                if (!p[0]) return;
                var pts = parseInt(p[2], 10);
                addRow(p[0], p[1] || '', isNaN(pts) ? 10 : pts);
            });
            refresh();
        }

        if (addBtn) addBtn.addEventListener('click', function () {
            var row = addRow('', '', 10);
            if (row) { refresh(); row.querySelector('[data-f=name]').focus(); }
        });
        // Yapay zeka onerisi / site taslagi alani doldurunca satirlar yeniden cizilir.
        store.addEventListener('signals:reload', load);
        load();
    })();
</script>
@if (isAdmin)
{
    <script>
        (function () {
            // Sitemizden doldur: taslak formu doldurur, kaydetmez.
            var draftForm = document.getElementById('draftForm');
            var draftBtn = document.getElementById('draftButton');
            var status = document.getElementById('draftStatus');

            function setField(id, value) {
                var el = document.getElementById(id);
                if (el && value) el.value = value;
            }

            draftForm.addEventListener('submit', function (e) {
                e.preventDefault();
                var hasContent = document.getElementById('Offering').value.trim();
                if (hasContent && !confirm('Formdaki mevcut bilgiler yapay zekâ taslağıyla değiştirilecek (kaydetmeden önce düzeltebilirsiniz). Devam edilsin mi?')) return;

                draftBtn.disabled = true;
                var label = draftBtn.textContent;
                draftBtn.textContent = 'Site okunuyor…';
                status.className = 'small mt-2 text-muted-2';
                status.textContent = 'Siteniz okunup yapay zekâ ile özetleniyor; 15-40 saniye sürebilir.';

                fetch(draftForm.action, { method: 'POST', body: new FormData(draftForm), headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { if (!r.ok) throw new Error('Sunucu hatası (' + r.status + ')'); return r.json(); })
                    .then(function (res) {
                        if (!res.ok) throw new Error(res.error || 'Taslak çıkarılamadı.');
                        var p = res.profile;
                        setField('CompanyName', p.companyName);
                        setField('Website', p.website);
                        setField('Offering', p.offering);
                        setField('ProblemsWeSolve', p.problems);
                        setField('IdealCustomer', p.idealCustomer);
                        setField('NotCustomers', p.notCustomers);
                        setField('Competitors', p.competitors);
                        setField('ExampleCustomers', p.exampleCustomers);
                        setField('CustomerKind', p.customerKind || '');
                        setField('BuyingSignals', p.buyingSignals);
                        setField('ScoringSignals', p.scoringSignals);
                        document.getElementById('ScoringSignals').dispatchEvent(new Event('signals:reload'));
                        setField('TargetTitles', res.titles);
                        status.className = 'small mt-2 text-success';
                        status.textContent = 'Taslak dolduruldu. Kontrol edip düzeltin, ardından Kaydet\'e basın.';
                    })
                    .catch(function (err) {
                        status.className = 'small mt-2 text-danger';
                        status.textContent = err.message;
                    })
                    .finally(function () {
                        draftBtn.disabled = false;
                        draftBtn.textContent = label;
                    });
            });

            // Puanlama anahtar kelimeleri: formdaki tanima gore yapay zeka onerir, kaydetmez.
            var signalsBtn = document.getElementById('suggestSignals');
            var signalsStatus = document.getElementById('signalsStatus');
            if (signalsBtn) signalsBtn.addEventListener('click', function () {
                var label = signalsBtn.textContent;
                var existing = document.getElementById('ScoringSignals');
                if (existing.value.trim() && !confirm('Mevcut puanlama anahtar kelimeleri yapay zekâ önerisiyle değiştirilecek. Devam edilsin mi?')) return;
                signalsBtn.disabled = true;
                signalsBtn.textContent = 'Üretiliyor…';
                signalsStatus.className = 'small mt-1 text-muted-2';
                signalsStatus.textContent = 'Yapay zekâ tanımınızdan ölçütler üretiyor; 10-20 saniye sürebilir.';
                var data = new FormData(document.getElementById('profileForm'));
                fetch(signalsBtn.dataset.url, { method: 'POST', body: data, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (!res.ok) throw new Error(res.error || 'Öneri alınamadı.');
                        existing.value = res.lines;
                        existing.dispatchEvent(new Event('signals:reload'));
                        signalsStatus.className = 'small mt-1 text-success';
                        signalsStatus.textContent = 'Öneri dolduruldu. Kontrol edip düzeltin, ardından Kaydet\'e basın.';
                    })
                    .catch(function (err) {
                        signalsStatus.className = 'small mt-1 text-danger';
                        signalsStatus.textContent = err.message;
                    })
                    .finally(function () {
                        signalsBtn.disabled = false;
                        signalsBtn.textContent = label;
                    });
            });
        })();
    </script>
}
}
