@model LeadDetailViewModel
@{
    var lead = Model.Lead;
    var contact = lead.Contact;
    var person = PersonDisplay.DisplayName(contact);
    ViewData["Title"] = $"{person} — Lead";

    var hasEmail = !string.IsNullOrWhiteSpace(contact?.Email);
    var canReveal = !hasEmail && !string.IsNullOrWhiteSpace(contact?.ApolloId);
    var tenure = contact?.TenureText();
    var returnUrl = Url.Action("Details", new { id = lead.Id });
}

<div class="mb-3">
    <a class="back-link" asp-action="Index">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        Lead'ler
    </a>
</div>

@if (TempData["LeadSuccess"] is string ok)
{
    <div class="alert alert-success" data-flash="success">@ok</div>
}
@if (TempData["LeadInfo"] is string info)
{
    <div class="alert alert-secondary" data-flash="info">@info</div>
}
@if (TempData["LeadError"] is string err)
{
    <div class="alert alert-danger" data-flash="error">@err</div>
}

<section class="lead-hero mb-4">
    <span class="avatar avatar-xl avatar-hue-@PersonDisplay.Hue(person)">@PersonDisplay.Initials(person)</span>
    <div class="lead-hero-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h1 class="lead-hero-name mb-0">@person</h1>
            <span class="lead-status @LeadStatusDisplay.Css(lead.Status)" id="leadStatusPill">@LeadStatusDisplay.Label(lead.Status)</span>
        </div>
        <div class="lead-hero-title">@(contact?.Title ?? "Ünvan bilinmiyor")</div>
        <a class="lead-hero-company" asp-controller="Company" asp-action="Details" asp-route-id="@lead.CompanyId">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4" />
            </svg>
            @lead.Company?.Name
            @if (!string.IsNullOrWhiteSpace(lead.Company?.City))
            {
                <span class="opacity-75">· @lead.Company.City</span>
            }
        </a>
        <div class="lead-hero-wait">
            <partial name="_LeadWait" model="new LeadWaitModel(lead, Model.FollowUpAfterDays)" />
        </div>
    </div>
    <div class="lead-hero-actions">
        <form method="post" asp-action="Toggle" asp-route-id="@lead.Id" asp-route-what="contacted" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button class="action-btn action-contacted action-lg @(lead.ContactedAt is not null ? "is-active" : "")" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
                </svg>
                <span class="action-label">İletişim kuruldu</span>
            </button>
        </form>
        <form method="post" asp-action="Toggle" asp-route-id="@lead.Id" asp-route-what="mailed" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button class="action-btn action-mailed action-lg @(lead.SentAt is not null ? "is-active" : "")" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
                </svg>
                <span class="action-label">Mail atıldı</span>
            </button>
        </form>
        <form method="post" asp-action="MarkReplied" asp-route-id="@lead.Id" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button class="action-btn action-replied action-lg @(lead.RepliedAt is not null ? "is-active" : "")" type="submit"
                    title="@(lead.RepliedAt is not null ? "Cevap işaretini kaldır" : "Kişi cevap verdi; takip listesinden çıkar")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 17 4 12l5-5" /><path d="M20 18v-2a4 4 0 0 0-4-4H4" />
                </svg>
                <span class="action-label">Cevap geldi</span>
            </button>
        </form>
        @if (lead.RepliedAt is null)
        {
            <form method="post" asp-action="Snooze" asp-route-id="@lead.Id" asp-route-days="3" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button class="action-btn action-snooze action-lg" type="submit" title="Takibi 3 gün ertele">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3a9 9 0 1 0 9 9" /><path d="M12 7v5l3 2" /><path d="M16 3h5l-5 5h5" />
                    </svg>
                    <span class="action-label">3 gün ertele</span>
                </button>
            </form>
        }
        @if (hasEmail)
        {
            <a class="action-btn action-compose action-lg" asp-controller="Email" asp-action="Compose" asp-route-leadId="@lead.Id">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
                <span class="action-label">E-posta yaz</span>
            </a>
        }
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">Kişi bilgileri</div>
            <div class="card-body">
                <div class="fact-grid">
                    <div class="fact">
                        <div class="fact-label">Şirketteki süresi</div>
                        @if (tenure is not null)
                        {
                            <div class="fact-value">@tenure</div>
                            <div class="fact-sub">@contact!.EmploymentStartDate!.Value.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))'dan beri</div>
                        }
                        else
                        {
                            <div class="fact-value fact-empty">Bilinmiyor</div>
                            <div class="fact-sub">@(canReveal ? "E-posta açılınca Apollo'dan gelir." : "Kaynakta bu bilgi yok.")</div>
                        }
                    </div>

                    <div class="fact">
                        <div class="fact-label">Ünvan</div>
                        <div class="fact-value">@(contact?.Title ?? "—")</div>
                        @if (!string.IsNullOrWhiteSpace(contact?.Headline) && contact.Headline != contact.Title)
                        {
                            <div class="fact-sub">@contact.Headline</div>
                        }
                    </div>

                    <div class="fact fact-wide">
                        <div class="fact-label">E-posta</div>
                        @if (hasEmail)
                        {
                            <div class="fact-value"><a href="mailto:@contact!.Email">@contact.Email</a></div>
                        }
                        else if (canReveal)
                        {
                            <div class="reveal-box">
                                <div>
                                    <div class="fact-value fact-empty">Henüz açılmadı</div>
                                    <div class="fact-sub">Açmak Apollo'da 1 kredi harcar. Çalışma süresi ve konum da birlikte gelir.</div>
                                </div>
                                <form method="post" asp-action="RevealEmail" asp-route-id="@lead.Id" class="m-0" id="revealForm"
                                      data-confirm="Kişinin e-postası Apollo'dan açılacak; bunun için 1 kredi harcanır. Çalışma süresi ve konum da birlikte gelir."
                                      data-confirm-title="E-posta getirilsin mi?" data-confirm-subject="@PersonDisplay.DisplayName(lead.Contact)"
                                      data-confirm-ok="1 kredi harca ve getir" data-confirm-tone="credit">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-reveal" type="submit" id="revealButton">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" />
                                        </svg>
                                        E-postayı getir
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="fact-value fact-empty">Yok</div>
                            <div class="fact-sub">Bu kişi firma sitesinden bulundu; Apollo kaydı yok.</div>
                        }
                    </div>

                    <div class="fact">
                        <div class="fact-label">Telefon</div>
                        @if (!string.IsNullOrWhiteSpace(contact?.Phone))
                        {
                            <div class="fact-value"><a href="tel:@contact.Phone">@contact.Phone</a></div>
                        }
                        else
                        {
                            <div class="fact-value fact-empty">—</div>
                        }
                    </div>

                    <div class="fact">
                        <div class="fact-label">Konum</div>
                        <div class="fact-value @(string.IsNullOrWhiteSpace(contact?.Location) ? "fact-empty" : "")">
                            @(contact?.Location ?? lead.Company?.City ?? "—")
                        </div>
                    </div>

                    <div class="fact">
                        <div class="fact-label">Profil</div>
                        @if (!string.IsNullOrWhiteSpace(contact?.SourceUrl))
                        {
                            <div class="fact-value">
                                <a href="@contact.SourceUrl" target="_blank" rel="noopener noreferrer">
                                    @(contact.SourceUrl.Contains("linkedin", StringComparison.OrdinalIgnoreCase) ? "LinkedIn profili" : "Kaynak sayfa") ↗
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="fact-value fact-empty">—</div>
                        }
                    </div>

                    <div class="fact">
                        <div class="fact-label">Kaynak</div>
                        <div class="fact-value">
                            @(contact?.Source switch
                            {
                                ContactSource.ApolloSearch => "Apollo",
                                ContactSource.LinkedInApollo => "LinkedIn + Apollo",
                                ContactSource.Website => "Firma sitesi",
                                _ => "—"
                            })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>E-posta geçmişi</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="tag tag-muted">@lead.SentEmails.Count e-posta</span>
                    @if (hasEmail)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Email" asp-action="Compose" asp-route-leadId="@lead.Id">Yeni e-posta</a>
                    }
                </span>
            </div>
            @if (lead.SentEmails.Count == 0)
            {
                <div class="card-body">
                    <div class="text-muted-2 small">
                        Bu kişiye henüz e-posta gönderilmedi. Gönderdiğiniz her e-posta, metniyle birlikte burada saklanır.
                    </div>
                </div>
            }
            else
            {
                <partial name="_EmailHistory" model="lead.SentEmails" />
            }
        </div>

        <div class="card">
            <div class="card-header">Notlar</div>
            <div class="card-body">
                <form method="post" asp-action="SaveNotes" asp-route-id="@lead.Id">
                    @Html.AntiForgeryToken()
                    <textarea class="form-control mb-3" name="notes" rows="4" maxlength="2000"
                              placeholder="Görüşme notları, sonraki adım, kiminle konuşuldu…">@lead.Notes</textarea>
                    <button class="btn btn-outline-primary btn-sm" type="submit">Notu kaydet</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">Takip</div>
            <div class="card-body">
                <ol class="timeline">
                    <li class="timeline-item is-done">
                        <span class="timeline-dot"></span>
                        <div>
                            <div class="timeline-title">Lead oluşturuldu</div>
                            <div class="timeline-date">@lead.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </li>
                    <li class="timeline-item @(lead.ContactedAt is not null ? "is-done is-contacted" : "")">
                        <span class="timeline-dot"></span>
                        <div>
                            <div class="timeline-title">İletişim kuruldu</div>
                            <div class="timeline-date">@(lead.ContactedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Henüz değil")</div>
                        </div>
                    </li>
                    <li class="timeline-item @(lead.SentAt is not null ? "is-done is-mailed" : "")">
                        <span class="timeline-dot"></span>
                        <div>
                            <div class="timeline-title">Mail atıldı</div>
                            <div class="timeline-date">@(lead.SentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Henüz değil")</div>
                        </div>
                    </li>

                    <li class="timeline-item @(lead.RepliedAt is not null ? "is-done is-replied" : "")">
                        <span class="timeline-dot"></span>
                        <div>
                            <div class="timeline-title">Cevap geldi</div>
                            <div class="timeline-date">
                                @if (lead.RepliedAt is not null)
                                {
                                    @lead.RepliedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                }
                                else if (lead.WaitingDays() is int w && lead.Status != LeadStatus.Ilgilenmedi)
                                {
                                    @($"{w} gündür bekleniyor")
                                }
                                else
                                {
                                    @:Henüz değil
                                }
                            </div>
                        </div>
                    </li>
                </ol>

                <form method="post" asp-action="UpdateStatus" asp-route-id="@lead.Id" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label class="form-label" for="leadStatus">Durum</label>
                    <select class="form-select" id="leadStatus" name="status" onchange="this.form.submit()">
                        @foreach (var s in Enum.GetValues<LeadStatus>())
                        {
                            <option value="@s" selected="@(lead.Status == s)">@LeadStatusDisplay.Label(s)</option>
                        }
                    </select>
                </form>
            </div>
        </div>

        @if (Model.OtherLeads.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">Aynı firmadaki diğer lead'ler</div>
                <div class="lead-mini-list">
                    @foreach (var other in Model.OtherLeads)
                    {
                        var otherName = PersonDisplay.DisplayName(other.Contact);
                        <a class="lead-mini" asp-action="Details" asp-route-id="@other.Id">
                            <span class="avatar avatar-sm avatar-hue-@PersonDisplay.Hue(otherName)">@PersonDisplay.Initials(otherName)</span>
                            <span class="lead-mini-body">
                                <span class="lead-mini-name">@otherName</span>
                                <span class="lead-mini-title">@other.Contact?.Title</span>
                            </span>
                            <span class="lead-status @LeadStatusDisplay.Css(other.Status)">@LeadStatusDisplay.Label(other.Status)</span>
                        </a>
                    }
                </div>
            </div>
        }

        <form method="post" asp-action="Delete" asp-route-id="@lead.Id"
              data-confirm="Lead ve e-posta geçmişi silinecek. Kişi ve firma kaydı silinmez."
              data-confirm-title="Lead silinsin mi?" data-confirm-subject="@PersonDisplay.DisplayName(lead.Contact)"
              data-confirm-ok="Evet, sil" data-confirm-tone="danger">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-danger" type="submit">Lead'i sil</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Onay penceresi data-confirm ile (site.js); bu dinleyici onaydan sonra calisir.
    document.getElementById('revealForm')?.addEventListener('submit', function () {
        var b = document.getElementById('revealButton');
        b.disabled = true;
        b.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Getiriliyor...';
    });
</script>
}
