@model LeadDetailViewModel
@{
    var lead = Model.Lead;
    var active = Model.SequenceRuns.FirstOrDefault(r => r.Status == LeadSequenceStatus.Active);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Otomatik mail dizisi</span>
        <a class="small" asp-controller="Sequence" asp-action="Index">Dizileri yönet</a>
    </div>
    <div class="card-body">
        @if (active is not null)
        {
            var steps = active.Sequence!.Steps.OrderBy(s => s.Order).ToList();
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div>
                    <div class="fw-semibold">@active.Sequence.Name</div>
                    <div class="small text-muted-2">
                        Sıradaki: adım @(steps.FindIndex(s => s.Order == active.CurrentStep) + 1)/@steps.Count
                        @if (active.NextSendAt is not null)
                        {
                            <span>· @active.NextSendAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                </div>
                <form method="post" asp-controller="Sequence" asp-action="Stop" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leadId" value="@lead.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button class="btn btn-sm btn-outline-danger">Durdur</button>
                </form>
            </div>
            <ol class="seq-mini">
                @foreach (var step in steps)
                {
                    var sent = lead.SentEmails.Any(e => e.SequenceStepId == step.Id);
                    <li class="@(sent ? "is-done" : step.Order == active.CurrentStep ? "is-next" : "")">
                        @(step.UseAi ? "AI mail" : step.Template?.Name ?? "Şablon") · +@step.DelayDays gün
                        @if (sent) { <span class="tag tag-success">gönderildi</span> }
                    </li>
                }
            </ol>
        }
        else
        {
            var reason = EgebisLeadFinder.Services.Sequences.SequenceService.SkipReason(lead, alreadyActive: false);
            if (reason is not null)
            {
                <div class="small text-muted-2 mb-2">Diziye eklenemez: @reason.</div>
            }
            else if (Model.Sequences.Count == 0)
            {
                <div class="small text-muted-2">Henüz dizi yok. <a asp-controller="Sequence" asp-action="Index">Dizi oluşturun →</a></div>
            }
            else
            {
                <form method="post" asp-controller="Sequence" asp-action="Enroll" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leadIds" value="@lead.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <select class="form-select form-select-sm" name="sequenceId">
                        @foreach (var s in Model.Sequences)
                        {
                            <option value="@s.Id">@s.Name (@s.Steps.Count adım)</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-primary text-nowrap">Diziye ekle</button>
                </form>
                <div class="form-text">Cevap gelince veya mail geri dönünce dizi kendiliğinden durur.</div>
            }

            var last = Model.SequenceRuns.FirstOrDefault();
            if (last is not null)
            {
                <div class="small text-muted-2 mt-2">
                    Son dizi: @last.Sequence?.Name — @(last.Status == LeadSequenceStatus.Completed ? "tamamlandı" : $"durdu ({last.StopReason})")
                    @if (last.FinishedAt is not null) { <span>· @last.FinishedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</span> }
                </div>
            }
        }
    </div>
</div>
