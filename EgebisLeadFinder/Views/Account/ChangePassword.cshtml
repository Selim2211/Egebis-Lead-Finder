@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre değiştir";
    var min = EgebisLeadFinder.Services.Auth.UserService.MinPasswordLength;
}
<div class="auth-wrap">
    <div class="card auth-card">
        <div class="card-body">
            <div class="auth-brand">
                <div>
                    <div class="auth-title">Şifre değiştir</div>
                    <div class="auth-sub">@User.Identity?.Name</div>
                </div>
            </div>

            @if (Model.Forced)
            {
                <div class="alert alert-warning py-2 small">Yöneticiniz size geçici bir şifre verdi. Devam etmek için kendi şifrenizi belirleyin.</div>
            }
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger py-2 small" role="alert">@Model.Error</div>
            }

            <form method="post" asp-action="ChangePassword">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="current">Mevcut şifre</label>
                    <input class="form-control" id="current" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="new">Yeni şifre</label>
                    <input class="form-control" id="new" name="NewPassword" type="password" autocomplete="new-password"
                           minlength="@min" required />
                    <div class="form-text">En az @min karakter.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="confirm">Yeni şifre (tekrar)</label>
                    <input class="form-control" id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">Şifreyi değiştir</button>
                    @if (!Model.Forced)
                    {
                        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Vazgeç</a>
                    }
                </div>
            </form>
            @if (Model.Forced)
            {
                <form method="post" asp-action="Logout" class="mt-3 text-center">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-link btn-sm" type="submit">Çıkış yap</button>
                </form>
            }
        </div>
    </div>
</div>
