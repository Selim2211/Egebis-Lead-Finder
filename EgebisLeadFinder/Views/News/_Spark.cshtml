@model int[]
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    const double w = 72, h = 22;
    var max = Math.Max(1, Model.Max());
    var step = Model.Length > 1 ? w / (Model.Length - 1) : w;
    var pts = string.Join(" ", Model.Select((v, i) => $"{(i * step).ToString("0.#", inv)},{(h - 2 - (h - 4) * v / max).ToString("0.#", inv)}"));
    var trend = Model.Length > 1 && Model[^1] > Model[0] ? "up" : Model.Sum() == 0 ? "flat" : "even";
}
<svg class="nx-spark is-@trend" viewBox="0 0 72 22" width="72" height="22" aria-hidden="true" focusable="false"><polyline points="@pts" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
