@model NewsCompaniesViewModel
@using EgebisLeadFinder.Services.News
@{
    ViewData["Title"] = "Şirketler · Haber Akışı";
    var back = Context.Request.Path + Context.Request.QueryString;
}

<div class="nx">
    <partial name="_NewsShell" model="Model.Shell" />

    <section class="nx-card">
        <h2 class="nx-card-h">Takip edilen şirketler <span class="nx-count">@Model.Rows.Count</span></h2>
        @if (Model.Rows.Count == 0)
        {
            <div class="nx-empty">Henüz takip edilen firma yok. Firma kartındaki <b>Takip et</b> düğmesini ya da favori yıldızını kullanın.</div>
        }
        else
        {
            <div class="nx-table" role="table" aria-label="Takip edilen şirketler">
                <div class="nx-tr nx-th" role="row">
                    <span role="columnheader">Şirket</span><span role="columnheader">Puan</span><span role="columnheader">Haber etkisi</span>
                    <span role="columnheader">7 gün</span><span role="columnheader">Denge</span><span role="columnheader">Son haber</span><span role="columnheader"></span>
                </div>
                @foreach (var p in Model.Rows)
                {
                    var other = Math.Max(0, p.Count30 - p.Positive - p.Negative);
                    var tot = Math.Max(1, p.Count30);
                    <div class="nx-tr" role="row">
                        <span class="nx-cell-name" role="cell">
                            <span class="nm-ava">@NewsFormat.Initials(p.Name)</span>
                            <span><a asp-controller="Company" asp-action="Details" asp-route-id="@p.CompanyId">@p.Name</a><small>@(string.IsNullOrWhiteSpace(p.Industry) ? "Sektör belirtilmemiş" : p.Industry)</small></span>
                        </span>
                        <span class="nx-num" role="cell" data-label="Puan">@p.Score</span>
                        <span role="cell" data-label="Haber etkisi">@if (p.Boost > 0) { <b class="is-up">▲ +@p.Boost</b> } else { <span class="nx-dim">—</span> }</span>
                        <span class="nx-cell-spark" role="cell" data-label="7 gün"><partial name="_Spark" model="p.Spark" /> <b>@p.Count7</b></span>
                        <span role="cell" data-label="Denge" title="Olumlu @p.Positive · Olumsuz @p.Negative · Diğer @other (son 30 gün)">
                            @if (p.Count30 == 0) { <span class="nx-dim">—</span> }
                            else
                            {
                                <span class="nx-balance"><i class="pos" style="width:@(100 * p.Positive / tot)%"></i><i class="neu" style="width:@(100 * other / tot)%"></i><i class="neg" style="width:@(100 * p.Negative / tot)%"></i></span>
                            }
                        </span>
                        <span class="nx-dim" role="cell" data-label="Son haber">@(p.LastAt is { } la ? NewsFormat.Ago(la) : "—")</span>
                        <span class="nx-cell-act" role="cell">
                            <a class="nx-btn is-ghost" asp-action="List" asp-route-company="@p.CompanyId">Haberleri</a>
                            @if (p.IsMine)
                            {
                                <form method="post" asp-action="ToggleWatch" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.CompanyId" />
                                    <input type="hidden" name="returnUrl" value="@back" />
                                    <button type="submit" class="nx-btn is-ghost" title="Takipten çıkar">Takipten çıkar</button>
                                </form>
                            }
                        </span>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/news-live.js" asp-append-version="true"></script>
}
