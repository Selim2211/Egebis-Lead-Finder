@model int[]
@using System.Globalization
@{
    // İtibar trend grafiği: son 7 günün gün sonu değerleri, yumuşak çizgi + dolgu.
    var v = Model.Length == 0 ? new[] { 0 } : Model;
    double lo = v.Min(), hi = v.Max();
    if (hi - lo < 4) { lo -= 3; hi += 3; }
    var pad = (hi - lo) * .15; lo = Math.Floor(lo - pad); hi = Math.Ceiling(hi + pad);
    const double W = 300, H = 150, L = 26, R = 6, T = 8, B = 20;
    double X(int i) => L + (W - L - R) * (v.Length == 1 ? .5 : (double)i / (v.Length - 1));
    double Y(double val) => T + (H - T - B) * (1 - (val - lo) / (hi - lo));
    string F(double d) => d.ToString("0.#", CultureInfo.InvariantCulture);
    var pts = v.Select((val, i) => (x: X(i), y: Y(val))).ToArray();
    var line = new System.Text.StringBuilder($"M{F(pts[0].x)},{F(pts[0].y)}");
    for (var i = 0; i < pts.Length - 1; i++)
    {
        var p0 = pts[Math.Max(0, i - 1)]; var p1 = pts[i]; var p2 = pts[i + 1]; var p3 = pts[Math.Min(pts.Length - 1, i + 2)];
        // Kontrol noktaları iki nokta arasında tutulur: eğri aşağı/yukarı taşmaz.
        double yMin = Math.Min(p1.y, p2.y), yMax = Math.Max(p1.y, p2.y);
        var c1 = Math.Clamp(p1.y + (p2.y - p0.y) / 6, yMin, yMax);
        var c2 = Math.Clamp(p2.y - (p3.y - p1.y) / 6, yMin, yMax);
        line.Append($" C{F(p1.x + (p2.x - p0.x) / 6)},{F(c1)} {F(p2.x - (p3.x - p1.x) / 6)},{F(c2)} {F(p2.x)},{F(p2.y)}");
    }
    var area = $"{line} L{F(pts[^1].x)},{F(H - B)} L{F(pts[0].x)},{F(H - B)} Z";
    var gid = "txg" + Guid.NewGuid().ToString("N")[..8];
    var names = new[] { "Paz", "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt" };
    var today = DateTime.UtcNow.AddHours(3).Date;
    var down = v[^1] < v[0];
}
<svg class="tx-chart @(down ? "is-down" : "")" viewBox="0 0 @F(W) @F(H)" role="img" aria-label="Son 7 günlük itibar trendi">
    <defs>
        <linearGradient id="@gid" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="currentColor" stop-opacity=".35" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
    </defs>
    @for (var g = 0; g <= 3; g++)
    {
        var val = lo + (hi - lo) * g / 3;
        <line class="tx-grid-l" x1="@F(L)" x2="@F(W - R)" y1="@F(Y(val))" y2="@F(Y(val))" />
        @Html.Raw($"<text class=\"tx-ax\" x=\"{F(L - 4)}\" y=\"{F(Y(val) + 3)}\" text-anchor=\"end\">{F(Math.Round(val))}</text>")
    }
    <path d="@area" fill="url(#@gid)" />
    <path class="tx-line" d="@line" fill="none" />
    @for (var i = 0; i < pts.Length; i++)
    {
        <circle class="tx-pt" cx="@F(pts[i].x)" cy="@F(pts[i].y)" r="2.6"><title>@v[i]</title></circle>
        @Html.Raw($"<text class=\"tx-ax\" x=\"{F(pts[i].x)}\" y=\"{F(H - 5)}\" text-anchor=\"middle\">{names[(int)today.AddDays(i - (pts.Length - 1)).DayOfWeek]}</text>")
    }
</svg>
