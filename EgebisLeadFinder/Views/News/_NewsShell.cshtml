@model NewsShellModel
@using EgebisLeadFinder.Services.News
@{
    var agent = Model.Agent;
    var stateClass = agent.State switch { "scanning" => "is-scanning", "resting" => "is-resting", "off" => "is-off", _ => "" };
    var stateLabel = agent.State switch { "scanning" => "TARANIYOR", "resting" => "DİNLENİYOR", "off" => "KAPALI", _ => "CANLI" };
    var tabs = new[]
    {
        ("overview", "Özet", "Index"), ("list", "Haberler", "List"), ("companies", "Şirketler", "Companies"),
        ("sectors", "Sektörler", "Sectors"), ("radar", "Radar", "Radar")
    };
    var back = Context.Request.Path + Context.Request.QueryString;
}

<link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />

@if (TempData["SettingsSaved"] is string saved)
{
    <div class="alert alert-success" data-flash="success">@saved</div>
}
@if (TempData["SettingsError"] is string err)
{
    <div class="alert alert-danger" data-flash="error">@err</div>
}

@if (Model.Strip.Count > 0 || Model.Headlines.Count > 0)
{
    <div class="nt-ticker" aria-label="Firma hareketleri">
        <div class="nt-ticker-track">
            @for (var pass = 0; pass < 2; pass++)
            {
                <div class="nt-ticker-set" aria-hidden="@(pass == 1 ? "true" : "false")">
                    @foreach (var p in Model.Strip)
                    {
                        var dir = p.WeekImpact > 0 ? "is-up" : p.WeekImpact < 0 ? "is-down" : "is-flat";
                        <a class="nt-tick nt-mv @dir" href="@(p.CompanyId is int cid ? Url.Action("List", "News", new { company = cid }) : Url.Action("List", "News", new { q = p.Name }))" title="Son 7 günün itibar etkisi · @p.Count7 haber">
                            <strong>@p.Name.ToUpper(new System.Globalization.CultureInfo("tr-TR"))</strong>
                            <span class="nt-mv-v">@(p.WeekImpact > 0 ? "+" : "")@p.WeekImpact</span>
                        </a>
                    }
                    @foreach (var t in Model.Headlines)
                    {
                        var subject = NewsFormat.Subject(t);
                        <a class="nt-tick cat-@t.Item.Category" href="@t.Item.Url" target="_blank" rel="noopener noreferrer">
                            <span class="nt-tick-arrow">@(t.Item.Category == "risk" ? "▼" : "▲")</span>
                            @if (!NewsFormat.TitleStartsWithSubject(subject, t.Item.Title)) { <strong>@subject</strong> }
                            <span class="nt-tick-t">@t.Item.Title</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<section class="nt-panel nx-hero @stateClass" id="ntPanel" aria-label="Haber ajanı"
         data-live-url="@Url.Action("Live")" data-cards-url="@Url.Action("Cards")" data-max-id="@Model.MaxId"
         data-can-inject="@(Model.CanInject ? "1" : "0")" data-target="@Model.InjectTarget" data-compact="@(Model.Compact ? "1" : "0")"
         data-next="@(agent.NextTickAt?.ToString("o"))">
    <div class="nx-bar">
        <div class="nt-brand">
            <span class="nt-live"><span class="nt-pulse" aria-hidden="true"></span><span id="ntState">@stateLabel</span></span>
            <div class="nt-title">
                Haber Ajanı
                <small>Şirket haberleri ve fırsat radarı</small>
            </div>
        </div>
        <nav class="nx-tabs" aria-label="Haber modülleri">
            @foreach (var (key, label, action) in tabs)
            {
                <a class="nx-tab @(Model.Active == key ? "is-on" : "")" asp-controller="News" asp-action="@action" aria-current="@(Model.Active == key ? "page" : null)">@label</a>
            }
        </nav>
        @{
            var region = EgebisLeadFinder.Models.NewsRegions.Normalize(Context.Request.Cookies[EgebisLeadFinder.Controllers.NewsController.RegionCookie]);
            var here = Context.Request.Path + Context.Request.QueryString;
        }
        <div class="nx-region" role="group" aria-label="Haber bölgesi">
            <a class="nx-region-opt @(region == "tr" ? "is-on" : "")" href="@Url.Action("SetRegion", "News", new { value = "tr", returnUrl = here })" title="Yalnızca Türkiye haberleri">TR</a>
            <a class="nx-region-opt @(region == "global" ? "is-on" : "")" href="@Url.Action("SetRegion", "News", new { value = "global", returnUrl = here })" title="Yalnızca yurt dışı haberleri">Global</a>
            <a class="nx-region-opt @(region is null ? "is-on" : "")" href="@Url.Action("SetRegion", "News", new { value = "all", returnUrl = here })" title="Tüm haberler">Tümü</a>
        </div>
        <form method="get" asp-controller="News" asp-action="List" class="nx-search" role="search">
            <input name="q" value="@Model.Q" placeholder="Şirket veya haber ara…" autocomplete="off" aria-label="Haber ara" />
        </form>
        <div class="nx-next">Sonraki tur <b id="ntCountdown">--:--</b></div>
        @if (Model.IsAdmin)
        {
            <form method="post" asp-controller="News" asp-action="ScanNow" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@back" />
                <button type="submit" class="nx-btn" title="Sıradaki tarama turunu hemen çalıştır">Şimdi tara</button>
            </form>
        }
    </div>

    <div class="nx-status">
        <div class="nt-now-q" id="ntQuery" aria-live="polite">
            @if (agent.State == "scanning") { <text>Taranıyor: <b>@agent.CurrentQuery</b><span class="nt-caret"></span></text> }
            else if (agent.State == "resting") { <text>Haber kaynağı geçici olarak yanıt vermedi; kısa süre sonra yeniden denenecek</text> }
            else if (agent.State == "off") { <text>Haber ajanı ayarlardan kapatılmış</text> }
            else { <text>Beklemede · sıradaki tur için hazır</text> }
        </div>
        <div class="nx-stats">
            @if (Model.LastRun is { } run)
            {
                <span class="nx-stat">Son tur <b>@run.StartedAt.ToLocalTime().ToString("HH:mm")</b></span>
            }
            <span class="nx-stat">Bugün taranan <b id="ntQueries">@Model.Counters.Queries</b></span>
            <span class="nx-stat">Yeni haber <b id="ntNew">@Model.Counters.NewToday</b></span>
            <span class="nx-stat">Önemli (4+) <b class="is-hot" id="ntHot">@Model.Counters.HotToday</b></span>
            <span class="nx-stat">Takipteki firma <b id="ntWatched">@Model.Counters.Watched</b></span>
        </div>
    </div>
    <div class="nt-bar" aria-hidden="true"><i id="ntBar"></i></div>
</section>

