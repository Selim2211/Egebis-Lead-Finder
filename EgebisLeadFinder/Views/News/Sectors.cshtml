@model NewsSectorsViewModel
@{
    ViewData["Title"] = "Sektörler · Haber Akışı";
}

<div class="nx">
    <partial name="_NewsShell" model="Model.Shell" />

    <section class="nx-card">
        <h2 class="nx-card-h">Sektörlere göre haberler <span class="nx-count">son 30 gün</span></h2>
        @if (Model.Sectors.Count == 0)
        {
            <div class="nx-empty">Henüz haber yok. Firmaları takibe alın ya da radar konusu ekleyin.</div>
        }
        else
        {
            <div class="nx-sector-grid">
                @foreach (var s in Model.Sectors)
                {
                    var other = Math.Max(0, s.Count - s.Positive - s.Negative);
                    var tot = Math.Max(1, s.Count);
                    <article class="nx-sector @(s.IsRadar ? "is-radar" : "")">
                        <header>
                            <h3>@s.Name</h3>
                            <span class="nx-dim">@(s.IsRadar ? "radar haberleri" : s.Companies + " firma")</span>
                        </header>
                        <div class="nx-sector-num"><b>@s.Count</b> haber</div>
                        <span class="nx-balance" title="Olumlu @s.Positive · Olumsuz @s.Negative · Diğer @other">
                            <i class="pos" style="width:@(100 * s.Positive / tot)%"></i><i class="neu" style="width:@(100 * other / tot)%"></i><i class="neg" style="width:@(100 * s.Negative / tot)%"></i>
                        </span>
                        <div class="nx-legend"><span class="pos">Olumlu @s.Positive</span><span class="neg">Olumsuz @s.Negative</span></div>
                        @if (s.Top.Count > 0)
                        {
                            <ul class="nx-top">
                                @foreach (var t in s.Top)
                                {
                                    <li><a href="@t.Url" target="_blank" rel="noopener noreferrer">@t.Title</a></li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/news-live.js" asp-append-version="true"></script>
}
