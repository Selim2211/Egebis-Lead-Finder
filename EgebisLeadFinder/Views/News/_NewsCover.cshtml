@model string
@* Fotoğraf yerine kategoriye göre çizim kapak: dış istek yok, bozuk resim yok. *@
<div class="nx-cover cv-@Model" aria-hidden="true">
    <svg viewBox="0 0 200 100" preserveAspectRatio="xMidYMax slice" focusable="false">
        @switch (Model)
        {
            case "yatirim":
                <path d="M0 100V62l26-16v16l26-16v16l26-16v16h30V30h16v-14h8v14h8v70z" fill="currentColor" opacity=".35" />
                <path d="M110 100V48h30v52zM150 100V58h40v42z" fill="currentColor" opacity=".55" />
                <path d="M118 56h6v8h-6zm12 0h6v8h-6zM158 66h8v8h-8zm16 0h8v8h-8z" fill="#fff" opacity=".5" />
                break;
            case "finans":
                <path d="M14 70h8V40h-8zm24 10h8V28h-8zm24-22h8V34h-8zm24-6h8V16h-8zm24 14h8V30h-8zm24-18h8V10h-8zm24 8h8V20h-8z" fill="currentColor" opacity=".5" />
                <polyline points="0,82 30,66 60,70 95,44 130,52 165,26 200,34" fill="none" stroke="currentColor" stroke-width="2" opacity=".85" />
                break;
            case "risk":
                <path d="M0 78c25-26 50 24 75-2s50 22 75-4 35-6 50-12v40H0z" fill="currentColor" opacity=".35" />
                <path d="M100 18 140 82H60z" fill="none" stroke="currentColor" stroke-width="3" opacity=".8" stroke-linejoin="round" />
                <path d="M100 40v24M100 70v4" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity=".9" />
                break;
            case "teknoloji":
                <path d="M10 30h50l12 14h40M10 60h30l14-14h46l12 20h60M120 20v20h60M140 80h50" fill="none" stroke="currentColor" stroke-width="2" opacity=".6" />
                <circle cx="60" cy="30" r="4" fill="currentColor" /><circle cx="112" cy="44" r="4" fill="currentColor" /><circle cx="180" cy="40" r="4" fill="currentColor" /><circle cx="54" cy="46" r="4" fill="currentColor" />
                break;
            case "yonetim":
                <path d="M30 100V30h46v70zm56 0V14h46v86zm56 0V44h38v56z" fill="currentColor" opacity=".4" />
                <path d="M40 42h8v8h-8zm16 0h8v8h-8zM96 28h8v8h-8zm16 0h8v8h-8zm-16 18h8v8h-8zm16 0h8v8h-8z" fill="#fff" opacity=".45" />
                break;
            default:
                <path d="M0 25h200M0 50h200M0 75h200M40 0v100M100 0v100M160 0v100" stroke="currentColor" stroke-width="1" opacity=".25" />
                <circle cx="100" cy="50" r="22" fill="none" stroke="currentColor" stroke-width="2" opacity=".5" />
                break;
        }
    </svg>
</div>
