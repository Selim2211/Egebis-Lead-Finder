@model NewsRow
@using EgebisLeadFinder.Services.News
@{
    var n = Model.Item;
    var isNew = ViewData["ForceNew"] is true || (ViewData["SeenAt"] is DateTime seen && n.FetchedAt > seen);
    var subject = NewsFormat.Subject(Model);
    var sent = NewsCategories.Sentiment(n.Category);
    string Tag(string s) => "#" + new string(s.Trim().ToUpper(new System.Globalization.CultureInfo("tr-TR")).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "");
}
<article class="nm s-@sent @(isNew ? "is-new" : "")" data-news-id="@n.Id">
    <div class="nm-meta">
        <time datetime="@n.PublishedAt.ToString("o")" title="@n.PublishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">@n.PublishedAt.ToLocalTime().ToString("HH:mm:ss")</time>
        <span class="nx-sent s-@sent">@NewsCategories.SentimentLabel(n.Category)</span>
    </div>
    <a class="nm-title" href="@n.Url" target="_blank" rel="noopener noreferrer">@n.Title</a>
    <div class="nm-tags">
        @if (n.CompanyId is int cid)
        {
            <a class="nm-tag" asp-controller="News" asp-action="List" asp-route-company="@cid">@Tag(subject)</a>
        }
        else if (subject != "Radar")
        {
            <span class="nm-tag">@Tag(subject)</span>
        }
        <a class="nm-tag" asp-controller="News" asp-action="List" asp-route-category="@n.Category">@Tag(NewsCategories.Label(n.Category))</a>
        @if (n.Importance >= 4) { <span class="nm-tag is-hot">#ÖNEMLİ</span> }
    </div>
</article>
