@model NewsFeedViewModel
@{
    ViewData["Title"] = "Haberler · Haber Akışı";
    ViewData["SeenAt"] = Model.Shell.SeenAt;
    string Scope(string s, string label, string title) =>
        $"<a class=\"nx-chip{(Model.Scope == s ? " is-on" : "")}\" href=\"{Url.Action("List", new { scope = s, q = Model.Q, category = Model.Category, importance = Model.Importance, days = Model.Days, company = Model.CompanyId, topic = Model.TopicId })}\" title=\"{title}\">{label}</a>";
}

<div class="nx">
    <partial name="_NewsShell" model="Model.Shell" />

    <div class="nw-new d-none" id="nwNew" role="status">
        <button type="button" class="nx-btn" id="nwNewBtn"><span id="nwNewText"></span></button>
    </div>

    <form method="get" asp-action="List" class="nx-card nx-filter">
        <div class="nx-filter-chips">
            @Html.Raw(Scope("all", "Tümü", "Tüm haberler"))
            @Html.Raw(Scope("mine", "Takip ettiklerim", "Takip ettiğiniz ve favori firmalar"))
            @Html.Raw(Scope("watch", "Firma haberleri", "Tüm takip edilen firmalar"))
            @Html.Raw(Scope("radar", "Radar", "Henüz tanımadığınız firmaların fırsat haberleri"))
            @if (Model.CompanyId is not null)
            {
                <a class="nx-chip is-on" asp-action="List" title="Firma filtresini kaldır">@(Model.CompanyName ?? "Firma") ×</a>
            }
            <input type="hidden" name="scope" value="@Model.Scope" />
            <input type="hidden" name="company" value="@Model.CompanyId" />
            <input type="hidden" name="topic" value="@Model.TopicId" />
        </div>
        <div class="nx-filter-row">
            <label>Ara<input name="q" value="@Model.Q" placeholder="Başlık veya firma adı" autocomplete="off" /></label>
            <label>Kategori
                <select name="category">
                    <option value="">Tümü</option>
                    @foreach (var c in NewsCategories.All) { <option value="@c" selected="@(Model.Category == c)">@NewsCategories.Label(c)</option> }
                </select>
            </label>
            <label>Önem
                <select name="importance">
                    <option value="0">Hepsi</option>
                    <option value="3" selected="@(Model.Importance == 3)">3 ve üstü</option>
                    <option value="4" selected="@(Model.Importance == 4)">4 ve üstü</option>
                    <option value="5" selected="@(Model.Importance == 5)">Yalnızca 5</option>
                </select>
            </label>
            <label>Dönem
                <select name="days">
                    <option value="1" selected="@(Model.Days == 1)">Son 24 saat</option>
                    <option value="3" selected="@(Model.Days == 3)">Son 3 gün</option>
                    <option value="7" selected="@(Model.Days == 7)">Son 7 gün</option>
                    <option value="30" selected="@(Model.Days == 30)">Son 30 gün</option>
                </select>
            </label>
            <span class="nx-filter-btns">
                <button class="nx-btn" type="submit">Süz</button>
                <a class="nx-btn is-ghost" asp-action="List" title="Temizle">×</a>
            </span>
        </div>
    </form>

    <div class="nc-grid mb-3" id="ncGrid">
        @foreach (var r in Model.Rows) { <partial name="_NewsCard" model="r" /> }
    </div>
    @if (Model.Rows.Count == 0)
    {
        <div class="nx-card nx-empty-lg" id="ncEmpty">
            <b>Gösterilecek haber yok</b>
            <span>Filtreyi değiştirin. Ajan her @Model.Shell.TickMinutes dakikada bir yeni tur atar; yeni haberler kendiliğinden buraya düşer.</span>
        </div>
    }
    <partial name="_Pager" model="Model.Pager" />
</div>

@section Scripts {
    <script src="~/js/news-live.js" asp-append-version="true"></script>
}
