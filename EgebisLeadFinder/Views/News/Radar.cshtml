@model NewsRadarViewModel
@using EgebisLeadFinder.Services.News
@{
    ViewData["Title"] = "Radar · Haber Akışı";
    ViewData["SeenAt"] = Model.Shell.SeenAt;
    var picked = Model.Topics.FirstOrDefault(t => t.Topic.Id == Model.SelectedTopicId);
}

<div class="nx">
    <partial name="_NewsShell" model="Model.Shell" />

    <section class="nx-card">
        <h2 class="nx-card-h">Radar konuları <span class="nx-count">@Model.Topics.Count</span></h2>
        <p class="nx-note">Radar, henüz tanımadığınız firmaların haberlerini bulur. Örnek: <code>yeni fabrika yatırımı</code> + şehir <code>Manisa</code>. Her konu en geç 30 dakikada bir taranır.</p>
        @if (Model.Shell.IsAdmin)
        {
            <form method="post" asp-action="AddTopic" class="nx-addtopic">
                @Html.AntiForgeryToken()
                <input name="query" maxlength="200" placeholder="yeni fabrika yatırımı" autocomplete="off" aria-label="Radar konusu" />
                <input name="city" maxlength="100" placeholder="Şehir (isteğe bağlı)" autocomplete="off" aria-label="Şehir" />
                <button type="submit" class="nx-btn">Ekle</button>
            </form>
        }
        @if (Model.Topics.Count == 0)
        {
            <div class="nx-empty">Henüz radar konusu yok.</div>
        }
        else
        {
            <div class="nx-topic-grid">
                @foreach (var t in Model.Topics)
                {
                    <article class="nx-topic-card @(t.Topic.Id == Model.SelectedTopicId ? "is-on" : "")">
                        <a class="nx-topic-main" asp-action="Radar" asp-route-topic="@t.Topic.Id">
                            <strong>@t.Topic.Query</strong>
                            <small>@(string.IsNullOrWhiteSpace(t.Topic.City) ? "Tüm Türkiye" : t.Topic.City)</small>
                            <span class="nx-topic-meta">
                                <partial name="_Spark" model="t.Spark" />
                                <b>@t.Count7</b> haber · 7 gün
                            </span>
                            <span class="nx-dim">Son tarama: @(t.LastScannedAt is { } at ? NewsFormat.Ago(at) : "henüz taranmadı")</span>
                        </a>
                        @if (Model.Shell.IsAdmin)
                        {
                            <form method="post" asp-action="RemoveTopic" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Topic.Id" />
                                <button type="submit" class="nx-btn is-ghost is-danger" title="Konuyu sil">Sil</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="nx-card">
        <h2 class="nx-card-h">
            @(picked is null ? "Radar haberleri" : picked.Topic.Query)
            @if (picked is not null) { <a class="nx-more" asp-action="Radar">Tümünü göster ×</a> }
        </h2>
        <div class="nc-grid">
            @foreach (var r in Model.Rows) { <partial name="_NewsCard" model="r" /> }
        </div>
        @if (Model.Rows.Count == 0) { <div class="nx-empty">Bu konuda henüz haber yok.</div> }
    </section>
</div>

@section Scripts {
    <script src="~/js/news-live.js" asp-append-version="true"></script>
}
