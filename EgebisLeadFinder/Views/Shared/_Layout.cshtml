@inject EgebisLeadFinder.Data.ApplicationDbContext LayoutDb
@inject EgebisLeadFinder.Services.UsageService LayoutUsage
@inject EgebisLeadFinder.Services.ISettingsService LayoutSettings
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache LayoutCache
@inject EgebisLeadFinder.Services.Inbox.NotificationService LayoutNotifications
@inject EgebisLeadFinder.Services.Inbox.InboxService LayoutInbox
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Takip bekleyen (iletisim kurulmamis) lead sayisi — ust menude rozet.
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
    var openLeadCount = 0;
    try
    {
        if (!signedIn) throw new InvalidOperationException();

        // Henuz temas edilmemis + cevap beklerken takip zamani gelmis lead'ler.
        var now = DateTime.UtcNow;
        var threshold = now.AddDays(-SettingKeys.DefaultFollowUpAfterDays);

        // Menudeki rozet her sayfada sorgu atiyordu; 15 sn onbellekte tutulur (yavas sunucuda sayfa basina bir DB gidis-donus az).
        openLeadCount = Microsoft.Extensions.Caching.Memory.CacheExtensions.GetOrCreate(LayoutCache, "layout:open-lead-count", e =>
        {
            e.AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(15);
            return LayoutDb.Leads.Count(l =>
                l.Status != LeadStatus.Ilgilenmedi && l.RepliedAt == null
                && (l.SnoozedUntil == null || l.SnoozedUntil <= now)
                && (l.ContactedAt == null
                    || (l.SentAt != null && l.SentAt <= threshold)
                    || (l.SentAt == null && l.ContactedAt <= threshold)));
        });
    }
    catch
    {
        // Rozet kozmetik; veritabani sorunu sayfayi dusurmemeli.
    }

    // "Şirketimiz" tanimlanmadiysa menudeki dugmede uyari noktasi.
    var profileConfigured = true;
    try
    {
        if (signedIn)
            profileConfigured = EgebisLeadFinder.Services.BusinessProfileService
                .Parse(await LayoutSettings.GetAsync(SettingKeys.BusinessProfile)).IsConfigured;
    }
    catch
    {
        // Kozmetik.
    }

    // Zil (okunmamis bildirim) ve Mesajlar (okunmamis cevap) rozetleri.
    var notifCount = 0;
    var unreadReplies = 0;
    try
    {
        if (signedIn)
        {
            notifCount = await LayoutNotifications.UnreadCountAsync(EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.UserId(User) ?? 0);
            unreadReplies = await LayoutInbox.UnreadRepliesAsync();
        }
    }
    catch
    {
        // Kozmetik.
    }

    // API kotasi %80'i gecen saglayici varsa menude uyari noktasi.
    var usageLevel = EgebisLeadFinder.Services.UsageLevel.Normal;
    try
    {
        if (signedIn) usageLevel = (await LayoutUsage.GetAlertAsync()).Level;
    }
    catch
    {
        // Kozmetik.
    }
}
<!DOCTYPE html>
<html lang="@EgebisLeadFinder.Localization.Loc.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1c33" />
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/logo.png" asp-append-version="true" />
    <title>@ViewData["Title"] - Egebis Lead Finder</title>
    <script type="importmap"></script>
    @* Tema, stil dosyalarindan once uygulanir: sayfa acilirken beyaz parlama olmasin. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('eg-theme');
                var dark = saved ? saved === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Yazi tipi sayfayi bekletmez: internet yavas/engelliyse sayfa sistem yazi tipiyle hemen acilir. *@
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" /></noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-2026.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EgebisLeadFinder.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg eg-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="eg-brand-mark">
                    <img src="~/img/logo.png" asp-append-version="true" width="36" height="36" alt="Egebis Lead Finder" decoding="async" />
                </span>
                <span>Egebis <span class="eg-brand-sub">Lead Finder</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (signedIn)
                {
                <ul class="navbar-nav me-auto gap-lg-1 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "BusinessProfile" ? "active" : "")"
                           asp-controller="BusinessProfile" asp-action="Index"
                           title="@(profileConfigured ? "Şirketimiz — şirket profili" : "Şirket profili tanımlı değil — yapay zekâ varsayılan tanımla çalışıyor")">
                            Şirketimiz
                            @if (!profileConfigured)
                            {
                                <span class="nav-alert-dot is-warning" aria-label="Tanımlı değil"></span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Company" && action is ("Search" or "SearchResult") ? "active" : "")"
                           asp-controller="Company" asp-action="Search">Firma Ara</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Company" && action is not ("Search" or "SearchResult" or "Compare") ? "active" : "")"
                           asp-controller="Company" asp-action="Index">Firmalar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Favorites" ? "active" : "")"
                           asp-controller="Favorites" asp-action="Index">Favoriler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "SearchProfiles" ? "active" : "")"
                           asp-controller="SearchProfiles" asp-action="Index">Arama Profilleri</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button type="button" class="nav-link dropdown-toggle btn btn-link @(controller == "Sector" || (controller == "Company" && action == "Compare") ? "active" : "")"
                                data-bs-toggle="dropdown" aria-expanded="false">Araçlar</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Sector" asp-action="Index">Sektör analizi (NACE)</a></li>
                            <li><a class="dropdown-item" asp-controller="Company" asp-action="Compare">Firma karşılaştırma</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Lead" || controller == "Email" ? "active" : "")"
                           asp-controller="Lead" asp-action="Index">
                            Lead'ler
                            @if (openLeadCount > 0)
                            {
                                <span class="nav-badge" title="İletişim bekleyen lead">@openLeadCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Template" ? "active" : "")"
                           asp-controller="Template" asp-action="Index"><span class="nav-label-long">Taslak Düzenleyici</span><span class="nav-label-short">Taslaklar</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Sequence" ? "active" : "")"
                           asp-controller="Sequence" asp-action="Index">Mail Dizileri</a>
                    </li>
                </ul>
                <ul class="navbar-nav mt-2 mt-lg-0 align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link nav-link-icon nav-inbox @(controller == "Inbox" ? "active" : "")"
                           asp-controller="Inbox" asp-action="Index" title="Mesajlar" aria-label="Mesajlar">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                            <span class="d-lg-none">Mesajlar</span>
                            <span class="nav-count" data-count="messages" @(unreadReplies == 0 ? "hidden" : "")>@unreadReplies</span>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <button type="button" class="nav-link nav-link-icon nav-bell" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false" title="Bildirimler" aria-label="Bildirimler">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                            </svg>
                            <span class="d-lg-none">Bildirimler</span>
                            <span class="nav-count is-hot" data-count="notifications" @(notifCount == 0 ? "hidden" : "")>@notifCount</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notif-menu" data-notif-panel data-url="@Url.Action("Panel", "Notifications")">
                            <div class="notif-empty">Yükleniyor…</div>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-icon nav-usage @(controller == "Usage" ? "active" : "")"
                           asp-controller="Usage" asp-action="Index"
                           title="@(usageLevel >= EgebisLeadFinder.Services.UsageLevel.Warning ? "API Kullanımı — bir API'nin kotası dolmak üzere" : "API Kullanımı")"
                           aria-label="API Kullanımı">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 14l4-4" /><path d="M3.34 19a10 10 0 1 1 17.32 0" />
                            </svg>
                            <span class="d-lg-none">API Kullanımı</span>
                            @if (usageLevel >= EgebisLeadFinder.Services.UsageLevel.Warning)
                            {
                                <span class="nav-alert-dot @(usageLevel >= EgebisLeadFinder.Services.UsageLevel.Critical ? "is-danger" : "is-warning")" aria-label="Kota uyarısı"></span>
                            }
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <button type="button" class="theme-toggle nav-help" data-bs-toggle="dropdown" aria-expanded="false"
                                title="Yardım" aria-label="Yardım">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><path d="M12 17h.01" />
                            </svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" data-tour-start data-tour-menu>Bu sayfanın turu</button></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="Index">Kullanıcı kılavuzu</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><partial name="_LanguageSwitch" /></li>
                    <li class="nav-item">
                        <button type="button" class="theme-toggle" id="themeToggle"
                                title="Açık / koyu tema" aria-label="Açık / koyu tema">
                            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                            </svg>
                            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                            </svg>
                        </button>
                    </li>
                    @if (isAdmin)
                    {
                    <li class="nav-item">
                        <a class="nav-link nav-link-icon @(controller == "Settings" ? "active" : "")"
                           asp-controller="Settings" asp-action="Index">
                            <svg class="nav-gear" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <span class="nav-settings-label">Ayarlar</span>
                        </a>
                    </li>
                    }
                    <li class="nav-item dropdown">
                        <button type="button" class="nav-link dropdown-toggle nav-user btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar avatar-sm avatar-hue-@PersonDisplay.Hue(User.Identity!.Name ?? "")">@PersonDisplay.Initials(EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.DisplayName(User))</span>
                            <span class="d-lg-none">@EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.DisplayName(User)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end nav-user-menu">
                            <li><span class="dropdown-item-text"><strong>@EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.DisplayName(User)</strong><br />@@@User.Identity.Name · @(isAdmin ? "Yönetici" : "Kullanıcı")</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (isAdmin)
                            {
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Kullanıcılar</a></li>
                                <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index">Audit log</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Usage" asp-action="Index">API Kullanımı</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Şifremi değiştir</a></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Çıkış yap</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
                }
                else
                {
                <ul class="navbar-nav ms-auto mt-2 mt-lg-0 align-items-lg-center">
                    <li class="nav-item"><partial name="_LanguageSwitch" /></li>
                </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="eg-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>Egebis Lead Finder — potansiyel müşteri keşif aracı</span>
            <span>B2B satış ve pazar analizi</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (signedIn)
    {
        <form id="notifReadAllForm" method="post" action="@Url.Action("ReadAll", "Notifications")" hidden>@Html.AntiForgeryToken()</form>
        <script>
            // Zil: acilinca son bildirimler yuklenir; rozetler sayfa acikken dakikada bir yenilenir.
            (function () {
                var panel = document.querySelector('[data-notif-panel]');
                var countUrl = '@Url.Action("Count", "Notifications")';
                function setCount(kind, n) {
                    document.querySelectorAll('[data-count="' + kind + '"]').forEach(function (b) {
                        b.textContent = n > 99 ? '99+' : String(n);
                        b.hidden = !n;
                    });
                }
                function loadPanel() {
                    if (!panel) return;
                    fetch(panel.dataset.url, { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.text() : ''; })
                        .then(function (html) {
                            if (!html) return;
                            panel.innerHTML = html;
                            var all = panel.querySelector('[data-notif-readall]');
                            if (all) all.addEventListener('click', function () {
                                fetch(document.getElementById('notifReadAllForm').action, { method: 'POST', credentials: 'same-origin', body: new FormData(document.getElementById('notifReadAllForm')) })
                                    .then(function () { setCount('notifications', 0); loadPanel(); });
                            });
                        });
                }
                if (panel) panel.parentElement.addEventListener('show.bs.dropdown', loadPanel);
                function refresh() {
                    if (document.visibilityState !== 'visible') return;
                    fetch(countUrl, { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (c) { if (c) { setCount('notifications', c.notifications); setCount('messages', c.messages); } })
                        .catch(function () { });
                }
                setInterval(refresh, 60000);
                document.addEventListener('visibilitychange', refresh);
            })();
        </script>
        <div id="apiStatusAlertHost" data-url="@Url.Action("StartupAlert", "Usage")"></div>
        <script>
            // Acilis uyarisi: API'lere canli erisim kontrolu sunucuda yapilir (5 dk onbellek); sayfa
            // acilisini bekletmemek icin sonradan yuklenir. Ayni durum oturumda bir kez gosterilir.
            (function () {
                var host = document.getElementById('apiStatusAlertHost');
                if (!host || !window.fetch || !window.bootstrap) return;
                function get(store, k) { try { return store.getItem(k); } catch (e) { return null; } }
                function set(store, k, v) { try { store.setItem(k, v); } catch (e) { } }
                var last = +(get(sessionStorage, 'eg-api-alert-at') || 0);
                if (Date.now() - last < 5 * 60 * 1000) return;
                fetch(host.dataset.url, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.text() : ''; })
                    .then(function (html) {
                        set(sessionStorage, 'eg-api-alert-at', String(Date.now()));
                        host.innerHTML = html;
                        var el = document.getElementById('apiStatusAlert');
                        if (!el) return;
                        var sig = el.dataset.signature;
                        var today = new Date().toISOString().slice(0, 10);
                        if (get(sessionStorage, 'eg-api-alert') === sig) return;
                        if (get(localStorage, 'eg-api-alert-snooze') === sig + '#' + today) return;
                        var modal = bootstrap.Modal.getOrCreateInstance(el);
                        el.addEventListener('hidden.bs.modal', function () { set(sessionStorage, 'eg-api-alert', sig); });
                        el.querySelector('[data-api-alert-snooze]').addEventListener('click', function () {
                            set(localStorage, 'eg-api-alert-snooze', sig + '#' + today);
                            modal.hide();
                        });
                        modal.show();
                    })
                    .catch(function () { });
            })();
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/favorites.js" asp-append-version="true"></script>
    <script src="~/js/compare.js" asp-append-version="true"></script>
    <script src="~/js/tour.js" asp-append-version="true"></script>
    <script src="~/js/progress-overlay.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
