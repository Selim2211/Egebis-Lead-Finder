@inject EgebisLeadFinder.Data.ApplicationDbContext LayoutDb
@inject EgebisLeadFinder.Services.UsageService LayoutUsage
@inject EgebisLeadFinder.Services.ISettingsService LayoutSettings
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache LayoutCache
@inject EgebisLeadFinder.Services.Inbox.NotificationService LayoutNotifications
@inject EgebisLeadFinder.Services.Inbox.InboxService LayoutInbox
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Takip bekleyen (iletisim kurulmamis) lead sayisi — ust menude rozet.
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
    var openLeadCount = 0;
    try
    {
        if (!signedIn) throw new InvalidOperationException();

        // Henuz temas edilmemis + cevap beklerken takip zamani gelmis lead'ler.
        var now = DateTime.UtcNow;
        var threshold = now.AddDays(-SettingKeys.DefaultFollowUpAfterDays);

        // Menudeki rozet her sayfada sorgu atiyordu; 15 sn onbellekte tutulur (yavas sunucuda sayfa basina bir DB gidis-donus az).
        openLeadCount = Microsoft.Extensions.Caching.Memory.CacheExtensions.GetOrCreate(LayoutCache, "layout:open-lead-count", e =>
        {
            e.AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(15);
            return LayoutDb.Leads.Count(l =>
                l.Status != LeadStatus.Ilgilenmedi && l.RepliedAt == null
                && (l.SnoozedUntil == null || l.SnoozedUntil <= now)
                && (l.ContactedAt == null
                    || (l.SentAt != null && l.SentAt <= threshold)
                    || (l.SentAt == null && l.ContactedAt <= threshold)));
        });
    }
    catch
    {
        // Rozet kozmetik; veritabani sorunu sayfayi dusurmemeli.
    }

    // "Şirketimiz" tanimlanmadiysa menudeki dugmede uyari noktasi.
    var profileConfigured = true;
    try
    {
        if (signedIn)
            profileConfigured = EgebisLeadFinder.Services.BusinessProfileService
                .Parse(await LayoutSettings.GetAsync(SettingKeys.BusinessProfile)).IsConfigured;
    }
    catch
    {
        // Kozmetik.
    }

    // Zil (okunmamis bildirim) ve Mesajlar (okunmamis cevap) rozetleri.
    var notifCount = 0;
    var unreadReplies = 0;
    try
    {
        if (signedIn)
        {
            notifCount = await LayoutNotifications.UnreadCountAsync(EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.UserId(User) ?? 0);
            unreadReplies = await LayoutInbox.UnreadRepliesAsync();
        }
    }
    catch
    {
        // Kozmetik.
    }

    // API kotasi %80'i gecen saglayici varsa menude uyari noktasi.
    var usageLevel = EgebisLeadFinder.Services.UsageLevel.Normal;
    try
    {
        if (signedIn) usageLevel = (await LayoutUsage.GetAlertAsync()).Level;
    }
    catch
    {
        // Kozmetik.
    }
}
<!DOCTYPE html>
<html lang="@EgebisLeadFinder.Localization.Loc.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3f4f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a12" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/logo.png" asp-append-version="true" />
    <title>@ViewData["Title"] - Egebis Lead Finder</title>
    <script type="importmap"></script>
    @* Tema, stil dosyalarindan once uygulanir: sayfa acilirken beyaz parlama olmasin. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('eg-theme');
                var dark = saved ? saved === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Yazi tipi sayfayi bekletmez: internet yavas/engelliyse sayfa sistem yazi tipiyle hemen acilir. *@
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=JetBrains+Mono:wght@500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=JetBrains+Mono:wght@500;600&display=swap" /></noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-2026.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-command.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-atelier.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EgebisLeadFinder.styles.css" asp-append-version="true" />
</head>
<body class="eg-app @(signedIn ? "has-side" : "no-side")">
    @{
        // Kenar cubugu ogeleri: (etiket, controller, action, ikon, aktif mi, rozet, uyari noktasi)
        string Ico(string name) => name switch
        {
            "home" => "<path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5 9.5V21h14V9.5\"/><path d=\"M10 21v-6h4v6\"/>",
            "search" => "<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/>",
            "building" => "<rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M9 8h.01M15 8h.01M9 12h.01M15 12h.01M9 16h.01M15 16h.01\"/>",
            "star" => "<path d=\"m12 3 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.9l1.1-6.5L2.6 9.8l6.5-.9z\"/>",
            "sliders" => "<path d=\"M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0\"/><circle cx=\"16\" cy=\"6\" r=\"2\"/><circle cx=\"10\" cy=\"12\" r=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"2\"/>",
            "target" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/>",
            "file" => "<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5M9 13h6M9 17h6\"/>",
            "repeat" => "<path d=\"m17 2 4 4-4 4\"/><path d=\"M3 11V9a3 3 0 0 1 3-3h15\"/><path d=\"m7 22-4-4 4-4\"/><path d=\"M21 13v2a3 3 0 0 1-3 3H3\"/>",
            "pie" => "<path d=\"M21 12A9 9 0 1 1 12 3v9z\"/><path d=\"M15 3.5A9 9 0 0 1 20.5 9H15z\"/>",
            "columns" => "<rect x=\"3\" y=\"4\" width=\"7\" height=\"16\" rx=\"1.5\"/><rect x=\"14\" y=\"4\" width=\"7\" height=\"16\" rx=\"1.5\"/>",
            "briefcase" => "<rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18\"/>",
            "gear" => "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z\"/>",
            _ => ""
        };
        var navGroups = new (string Title, (string Label, string Ctrl, string Act, string Icon, bool Active, int Badge, bool Dot)[] Items)[]
        {
            ("Keşfet", new[]
            {
                ("Panel", "Home", "Index", "home", controller == "Home", 0, false),
                ("Firma Ara", "Company", "Search", "search", controller == "Company" && action is ("Search" or "SearchResult"), 0, false),
                ("Firmalar", "Company", "Index", "building", controller == "Company" && action is not ("Search" or "SearchResult" or "Compare"), 0, false),
                ("Favoriler", "Favorites", "Index", "star", controller == "Favorites", 0, false),
                ("Arama Profilleri", "SearchProfiles", "Index", "sliders", controller == "SearchProfiles", 0, false),
            }),
            ("Satış", new[]
            {
                ("Lead'ler", "Lead", "Index", "target", controller == "Lead" || controller == "Email", openLeadCount, false),
                ("Taslak Düzenleyici", "Template", "Index", "file", controller == "Template", 0, false),
                ("Mail Dizileri", "Sequence", "Index", "repeat", controller == "Sequence", 0, false),
            }),
            ("Araçlar", new[]
            {
                ("Sektör analizi", "Sector", "Index", "pie", controller == "Sector", 0, false),
                ("Firma karşılaştırma", "Company", "Compare", "columns", controller == "Company" && action == "Compare", 0, false),
            }),
        };
    }
    <a class="skip-link" href="#main">İçeriğe geç</a>
    @if (signedIn)
    {
    <aside class="eg-side" id="egSide" aria-label="Ana menü">
        <div class="eg-side-head">
            <a class="eg-side-brand" asp-controller="Home" asp-action="Index" title="Egebis Lead Finder">
                <span class="eg-brand-mark"><img src="~/img/logo.png" asp-append-version="true" width="32" height="32" alt="Egebis Lead Finder" decoding="async" /></span>
                <span class="eg-side-brand-text">Egebis <small>Lead Finder</small></span>
            </a>
            <button type="button" class="eg-side-collapse" id="egSideCollapse" aria-label="Menüyü daralt" title="Menüyü daralt">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
            </button>
        </div>
        <nav class="eg-side-nav" id="egSideNav">
            <span class="eg-side-ind" aria-hidden="true"></span>
            @foreach (var group in navGroups)
            {
                <div class="eg-side-group">
                    <div class="eg-side-title">@group.Title</div>
                    @foreach (var it in group.Items)
                    {
                        <a class="eg-side-link @(it.Active ? "is-active" : "")" href="@Url.Action(it.Act, it.Ctrl)" title="@it.Label" @(it.Active ? "aria-current=page" : "")>
                            <svg class="eg-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(Ico(it.Icon))</svg>
                            <span class="eg-side-label">@it.Label</span>
                            @if (it.Badge > 0)
                            {
                                <span class="nav-badge" title="İletişim bekleyen lead">@it.Badge</span>
                            }
                        </a>
                    }
                </div>
            }
        </nav>
        <div class="eg-side-foot">
            <a class="eg-side-link @(controller == "BusinessProfile" ? "is-active" : "")" href="@Url.Action("Index", "BusinessProfile")"
               title="@(profileConfigured ? "Şirketimiz — şirket profili" : "Şirket profili tanımlı değil — yapay zekâ varsayılan tanımla çalışıyor")">
                <svg class="eg-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(Ico("briefcase"))</svg>
                <span class="eg-side-label">Şirketimiz</span>
                @if (!profileConfigured)
                {
                    <span class="nav-alert-dot is-warning" aria-label="Tanımlı değil"></span>
                }
            </a>
            @if (isAdmin)
            {
                <a class="eg-side-link @(controller == "Settings" ? "is-active" : "")" href="@Url.Action("Index", "Settings")" title="Ayarlar">
                    <svg class="eg-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(Ico("gear"))</svg>
                    <span class="eg-side-label">Ayarlar</span>
                </a>
            }
        </div>
    </aside>
    <div class="eg-side-backdrop" id="egSideBackdrop" hidden></div>
    }

    <div class="eg-shell">
        <header class="eg-topbar">
            @if (signedIn)
            {
                <button type="button" class="tb-btn eg-burger" id="egBurger" aria-label="Menüyü aç" aria-controls="egSide" aria-expanded="false">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            }
            else
            {
                <a class="eg-top-brand" asp-controller="Home" asp-action="Index">
                    <span class="eg-brand-mark"><img src="~/img/logo.png" asp-append-version="true" width="30" height="30" alt="Egebis Lead Finder" decoding="async" /></span>
                    <span>Egebis <small>Lead Finder</small></span>
                </a>
            }
            <div class="eg-top-title">@ViewData["Title"]</div>
            <div class="eg-top-actions">
                @if (signedIn)
                {
                    <button type="button" class="eg-cmd-btn" data-cmd-open aria-label="Komut paleti" title="Ara ve git (Ctrl+K)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                        <span class="eg-cmd-text">Ara ve git</span>
                        <kbd>Ctrl K</kbd>
                    </button>
                    <a class="tb-btn nav-inbox @(controller == "Inbox" ? "is-active" : "")" href="@Url.Action("Index", "Inbox")" title="Mesajlar" aria-label="Mesajlar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        <span class="nav-count" data-count="messages" @(unreadReplies == 0 ? "hidden" : "")>@unreadReplies</span>
                    </a>
                    <div class="dropdown">
                        <button type="button" class="tb-btn nav-bell" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false" title="Bildirimler" aria-label="Bildirimler">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                            <span class="nav-count is-hot" data-count="notifications" @(notifCount == 0 ? "hidden" : "")>@notifCount</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notif-menu" data-notif-panel data-url="@Url.Action("Panel", "Notifications")">
                            <div class="notif-empty">Yükleniyor…</div>
                        </div>
                    </div>
                    <a class="tb-btn nav-usage @(controller == "Usage" ? "is-active" : "")" href="@Url.Action("Index", "Usage")"
                       title="@(usageLevel >= EgebisLeadFinder.Services.UsageLevel.Warning ? "API Kullanımı — bir API'nin kotası dolmak üzere" : "API Kullanımı")" aria-label="API Kullanımı">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 14l4-4" /><path d="M3.34 19a10 10 0 1 1 17.32 0" /></svg>
                        @if (usageLevel >= EgebisLeadFinder.Services.UsageLevel.Warning)
                        {
                            <span class="nav-alert-dot @(usageLevel >= EgebisLeadFinder.Services.UsageLevel.Critical ? "is-danger" : "is-warning")" aria-label="Kota uyarısı"></span>
                        }
                    </a>
                    <div class="dropdown">
                        <button type="button" class="tb-btn nav-help" data-bs-toggle="dropdown" aria-expanded="false" title="Yardım" aria-label="Yardım">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><path d="M12 17h.01" /></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" data-tour-start data-tour-menu>Bu sayfanın turu</button></li>
                            <li><a class="dropdown-item" asp-controller="Help" asp-action="Index">Kullanıcı kılavuzu</a></li>
                        </ul>
                    </div>
                }
                <partial name="_LanguageSwitch" />
                @if (signedIn)
                {
                    <button type="button" class="tb-btn theme-toggle" id="themeToggle" title="Açık / koyu tema" aria-label="Açık / koyu tema">
                        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
                    </button>
                    <div class="dropdown">
                        <button type="button" class="eg-user-btn nav-user" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Hesap menüsü">
                            <span class="avatar avatar-sm avatar-hue-@PersonDisplay.Hue(User.Identity!.Name ?? "")">@PersonDisplay.Initials(EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.DisplayName(User))</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end nav-user-menu">
                            <li><span class="dropdown-item-text"><strong>@EgebisLeadFinder.Services.Auth.ClaimsPrincipalExtensions.DisplayName(User)</strong><br />@@@User.Identity.Name · @(isAdmin ? "Yönetici" : "Kullanıcı")</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (isAdmin)
                            {
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Kullanıcılar</a></li>
                                <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index">Audit log</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Usage" asp-action="Index">API Kullanımı</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Şifremi değiştir</a></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Çıkış yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>

        <main class="container pb-5" id="main">
            @RenderBody()
        </main>

        <footer class="eg-footer">
            <div class="container d-flex justify-content-between flex-wrap gap-2">
                <span>Egebis Lead Finder — potansiyel müşteri keşif aracı</span>
                <span>B2B satış ve pazar analizi</span>
            </div>
        </footer>
    </div>

    @if (signedIn)
    {
    <div class="eg-cmd" id="egCmd" hidden>
        <div class="eg-cmd-backdrop" data-cmd-close></div>
        <div class="eg-cmd-panel" role="dialog" aria-modal="true" aria-label="Komut paleti">
            <input type="text" id="egCmdInput" class="eg-cmd-input" placeholder="Sayfa ara ya da firma adı yaz…" autocomplete="off" aria-label="Komut ara" />
            <ul class="eg-cmd-list" id="egCmdList" role="listbox"></ul>
            <div class="eg-cmd-foot"><span><kbd>↑</kbd><kbd>↓</kbd> gez</span><span><kbd>Enter</kbd> aç</span><span><kbd>Esc</kbd> kapat</span></div>
        </div>
    </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (signedIn)
    {
        <form id="notifReadAllForm" method="post" action="@Url.Action("ReadAll", "Notifications")" hidden>@Html.AntiForgeryToken()</form>
        <script>
            // Zil: acilinca son bildirimler yuklenir; rozetler sayfa acikken dakikada bir yenilenir.
            (function () {
                var panel = document.querySelector('[data-notif-panel]');
                var countUrl = '@Url.Action("Count", "Notifications")';
                function setCount(kind, n) {
                    document.querySelectorAll('[data-count="' + kind + '"]').forEach(function (b) {
                        b.textContent = n > 99 ? '99+' : String(n);
                        b.hidden = !n;
                    });
                }
                function loadPanel() {
                    if (!panel) return;
                    fetch(panel.dataset.url, { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.text() : ''; })
                        .then(function (html) {
                            if (!html) return;
                            panel.innerHTML = html;
                            var all = panel.querySelector('[data-notif-readall]');
                            if (all) all.addEventListener('click', function () {
                                fetch(document.getElementById('notifReadAllForm').action, { method: 'POST', credentials: 'same-origin', body: new FormData(document.getElementById('notifReadAllForm')) })
                                    .then(function () { setCount('notifications', 0); loadPanel(); });
                            });
                        });
                }
                if (panel) panel.parentElement.addEventListener('show.bs.dropdown', loadPanel);
                function refresh() {
                    if (document.visibilityState !== 'visible') return;
                    fetch(countUrl, { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (c) { if (c) { setCount('notifications', c.notifications); setCount('messages', c.messages); } })
                        .catch(function () { });
                }
                setInterval(refresh, 60000);
                document.addEventListener('visibilitychange', refresh);
            })();
        </script>
        <div id="apiStatusAlertHost" data-url="@Url.Action("StartupAlert", "Usage")"></div>
        <script>
            // Acilis uyarisi: API'lere canli erisim kontrolu sunucuda yapilir (5 dk onbellek); sayfa
            // acilisini bekletmemek icin sonradan yuklenir. Ayni durum oturumda bir kez gosterilir.
            (function () {
                var host = document.getElementById('apiStatusAlertHost');
                if (!host || !window.fetch || !window.bootstrap) return;
                function get(store, k) { try { return store.getItem(k); } catch (e) { return null; } }
                function set(store, k, v) { try { store.setItem(k, v); } catch (e) { } }
                var last = +(get(sessionStorage, 'eg-api-alert-at') || 0);
                if (Date.now() - last < 5 * 60 * 1000) return;
                fetch(host.dataset.url, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.text() : ''; })
                    .then(function (html) {
                        set(sessionStorage, 'eg-api-alert-at', String(Date.now()));
                        host.innerHTML = html;
                        var el = document.getElementById('apiStatusAlert');
                        if (!el) return;
                        var sig = el.dataset.signature;
                        var today = new Date().toISOString().slice(0, 10);
                        if (get(sessionStorage, 'eg-api-alert') === sig) return;
                        if (get(localStorage, 'eg-api-alert-snooze') === sig + '#' + today) return;
                        var modal = bootstrap.Modal.getOrCreateInstance(el);
                        el.addEventListener('hidden.bs.modal', function () { set(sessionStorage, 'eg-api-alert', sig); });
                        el.querySelector('[data-api-alert-snooze]').addEventListener('click', function () {
                            set(localStorage, 'eg-api-alert-snooze', sig + '#' + today);
                            modal.hide();
                        });
                        modal.show();
                    })
                    .catch(function () { });
            })();
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/favorites.js" asp-append-version="true"></script>
    <script src="~/js/compare.js" asp-append-version="true"></script>
    <script src="~/js/tour.js" asp-append-version="true"></script>
    <script src="~/js/progress-overlay.js" asp-append-version="true"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    <script src="~/js/command.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
