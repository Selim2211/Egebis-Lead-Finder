@inject EgebisLeadFinder.Data.ApplicationDbContext LayoutDb
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Takip bekleyen (iletisim kurulmamis) lead sayisi — ust menude rozet.
    var openLeadCount = 0;
    try
    {
        // Henuz temas edilmemis + cevap beklerken takip zamani gelmis lead'ler.
        var now = DateTime.UtcNow;
        var threshold = now.AddDays(-SettingKeys.DefaultFollowUpAfterDays);

        openLeadCount = LayoutDb.Leads.Count(l =>
            l.Status != LeadStatus.Ilgilenmedi && l.RepliedAt == null
            && (l.SnoozedUntil == null || l.SnoozedUntil <= now)
            && (l.ContactedAt == null
                || (l.SentAt != null && l.SentAt <= threshold)
                || (l.SentAt == null && l.ContactedAt <= threshold)));
    }
    catch
    {
        // Rozet kozmetik; veritabani sorunu sayfayi dusurmemeli.
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1c33" />
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/logo.png" asp-append-version="true" />
    <title>@ViewData["Title"] - Egebis Lead Finder</title>
    <script type="importmap"></script>
    @* Tema, stil dosyalarindan once uygulanir: sayfa acilirken beyaz parlama olmasin. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('eg-theme');
                var dark = saved ? saved === 'dark'
                    : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EgebisLeadFinder.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg eg-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="eg-brand-mark">
                    <img src="~/img/logo.png" asp-append-version="true" width="36" height="36" alt="Egebis Lead Finder" decoding="async" />
                </span>
                <span>Egebis <span class="eg-brand-sub">Lead Finder</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto gap-lg-1 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Panel</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Company" && action == "Search" ? "active" : "")"
                           asp-controller="Company" asp-action="Search">Firma Ara</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Company" && action != "Search" ? "active" : "")"
                           asp-controller="Company" asp-action="Index">Firmalar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Lead" || controller == "Email" ? "active" : "")"
                           asp-controller="Lead" asp-action="Index">
                            Lead'ler
                            @if (openLeadCount > 0)
                            {
                                <span class="nav-badge" title="İletişim bekleyen lead">@openLeadCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Template" ? "active" : "")"
                           asp-controller="Template" asp-action="Index">Taslak Düzenleyici</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Sequence" ? "active" : "")"
                           asp-controller="Sequence" asp-action="Index">Mail Dizileri</a>
                    </li>
                </ul>
                <ul class="navbar-nav mt-2 mt-lg-0 align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <button type="button" class="theme-toggle" id="themeToggle"
                                title="Açık / koyu tema" aria-label="Açık / koyu tema">
                            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                            </svg>
                            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                            </svg>
                        </button>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-icon @(controller == "Settings" ? "active" : "")"
                           asp-controller="Settings" asp-action="Index">
                            <svg class="nav-gear" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            Ayarlar
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="eg-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>Egebis Lead Finder — potansiyel müşteri keşif aracı</span>
            <span>SAP kullanan üretici firmalar için</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/progress-overlay.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
