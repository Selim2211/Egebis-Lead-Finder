@using EgebisLeadFinder.Services.Quality
@model GoldItem
<div class="row g-2">
    <div class="col-md-5">
        <label class="form-label small">Ad (ör. Beyaz eşya)</label>
        <input class="form-control form-control-sm" name="name" value="@Model.Name" maxlength="100" required />
    </div>
    <div class="col-md-4">
        <label class="form-label small">6 haneli NACE kodu</label>
        <input class="form-control form-control-sm" name="naceCode" value="@Model.NaceCode" placeholder="27.51.08" maxlength="12" required />
    </div>
    <div class="col-md-3">
        <label class="form-label small">Denenecek firma sayısı</label>
        <input class="form-control form-control-sm" type="number" name="maxCompanies" value="@Model.MaxCompanies" min="5" max="100" />
    </div>
    <div class="col-md-6">
        <label class="form-label small">Bilinen üreticiler (alan adı, satır satır)</label>
        <textarea class="form-control form-control-sm" name="producers" rows="4" placeholder="arcelik.com.tr">@string.Join("\n", Model.Producers)</textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label small">Üretici olmadığını bildiğiniz firmalar (bayi, e-ticaret, rehber…)</label>
        <textarea class="form-control form-control-sm" name="notProducers" rows="4">@string.Join("\n", Model.NotProducers)</textarea>
    </div>
</div>
