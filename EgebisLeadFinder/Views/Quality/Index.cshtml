@using EgebisLeadFinder.Services.Quality
@model List<QualityRow>
@{
    ViewData["Title"] = "Kalite Ölçümü";
    string Pct(double? v) => v is null ? "—" : $"%{Math.Round(v.Value * 100)}";
}

<div class="page-head">
    <div>
        <h1>Kalite Ölçümü</h1>
        <div class="page-sub">Bilinen üreticilerle arama kalitesini yüzde olarak ölçün: bulunanların kaçı gerçekten üretici, bilinen üreticilerin kaçı bulundu.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Settings" asp-action="Index">Ayarlar</a>
</div>

@if (TempData["QualityError"] is string qError)
{
    <div class="alert alert-danger" data-flash="error">@qError</div>
}
@if (TempData["QualityOk"] is string qOk)
{
    <div class="alert alert-success" data-flash="success">@qOk</div>
}

<div class="card mb-3">
    <div class="card-body small">
        <p class="mb-2">
            <strong>Nasıl çalışır?</strong> Her kalem bir NACE kodu ve o kod için <em>bildiğiniz</em> üreticilerin alan adlarıdır.
            "Ölç"e basınca uygulama o kod için gerçek bir arama yapar (Serper ve Gemini kredisi harcar, bulunan firmalar firma havuzuna eklenir).
        </p>
        <ul class="mb-0">
            <li><strong>Doğruluk:</strong> sizin etiketlediğiniz firmalar arasında, gelenlerin kaçı gerçekten üretici. Ne kadar çok firma etiketlerseniz o kadar güvenilir olur.</li>
            <li><strong>Kapsama:</strong> bildiğiniz üreticilerin kaçı sonuçta çıktı.</li>
            <li>Sonuçtaki etiketsiz firmaların yanındaki <em>Üretici / Değil</em> düğmeleri firmayı ölçü setine ekler; sonra rakamlar yeniden hesaplanır.</li>
        </ul>
    </div>
</div>

@foreach (var row in Model)
{
    var item = row.Item;
    var run = row.Run;
    var eval = row.Eval;
    <div class="card mb-3" id="item-@item.Id">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                <strong>@item.Name</strong>
                <span class="text-muted-2">· NACE @item.NaceCode · @item.Producers.Count bilinen üretici · @item.NotProducers.Count üretici değil</span>
            </span>
            <span class="d-flex gap-2">
                <form asp-action="Start" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-accent btn-sm" @(run?.Running == true ? "disabled" : null)
                            data-confirm="Gerçek bir arama yapılacak: Serper ve Gemini kredisi harcanır ve bulunan firmalar firma havuzuna eklenir."
                            data-confirm-title="Ölçüm başlatılsın mı?" data-confirm-ok="Ölç" data-confirm-tone="credit">
                        @(run?.Running == true ? "Ölçülüyor…" : "Ölç")
                    </button>
                </form>
                <form asp-action="DeleteItem" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"
                            data-confirm="Bu ölçü seti kalemi silinecek." data-confirm-title="Kalem silinsin mi?" data-confirm-ok="Sil">Sil</button>
                </form>
            </span>
        </div>
        <div class="card-body">
            @if (run is null)
            {
                <p class="text-muted-2 mb-3">Henüz ölçülmedi.</p>
            }
            else if (run.Running)
            {
                <p class="mb-3"><span class="spinner-border spinner-border-sm me-2"></span>Arama sürüyor (birkaç dakika sürebilir). Bitince sayfa kendiliğinden yenilenir.</p>
            }
            else if (run.Error is not null)
            {
                <div class="alert alert-danger">@run.Error</div>
            }
            else if (eval is not null)
            {
                <div class="d-flex flex-wrap gap-4 mb-2">
                    <div><div class="text-muted-2 small">Doğruluk</div><div class="fs-3 fw-semibold">@Pct(eval.Precision)</div>
                        <div class="small text-muted-2">@eval.Found.Count doğru / @eval.Wrong.Count yanlış</div></div>
                    <div><div class="text-muted-2 small">Kapsama</div><div class="fs-3 fw-semibold">@Pct(eval.Recall)</div>
                        <div class="small text-muted-2">@eval.Found.Count bulundu / @eval.Missed.Count kaçtı</div></div>
                    <div><div class="text-muted-2 small">Gelen firma</div><div class="fs-3 fw-semibold">@eval.Returned</div>
                        <div class="small text-muted-2">@eval.Unlabeled.Count etiketsiz · @run.Dropped elendi</div></div>
                </div>
                <div class="small text-muted-2 mb-3">
                    @run.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ölçümü.
                    @if (eval.Unlabeled.Count > eval.Found.Count + eval.Wrong.Count)
                    {
                        <span class="text-warning">Gelenlerin çoğu etiketsiz; doğruluk yüzdesi bu yüzden güvenilir değil. Aşağıdan etiketleyin.</span>
                    }
                    @if (run.Warning is not null) { <span> · @run.Warning</span> }
                </div>

                @if (eval.Missed.Count > 0)
                {
                    <div class="mb-3"><span class="fw-semibold">Kaçanlar:</span> @string.Join(", ", eval.Missed)</div>
                }
                @if (eval.Wrong.Count > 0)
                {
                    <div class="mb-3"><span class="fw-semibold text-danger">Yanlış gelenler:</span> @string.Join(", ", eval.Wrong)</div>
                }

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Firma</th><th>Tür</th><th>Kanıt</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var firm in run.Firms)
                        {
                            var d = ProducerEval.NormalizeDomain(firm.Domain);
                            var isFound = eval.Found.Contains(d);
                            var isWrong = eval.Wrong.Contains(d);
                            <tr>
                                <td>
                                    <div class="fw-semibold">@firm.Name</div>
                                    <a class="small" href="https://@d" target="_blank" rel="noopener noreferrer">@d</a>
                                </td>
                                <td>@(firm.Kind switch { "Producer" => "Üretici", "Contract" => "Fason", "Uncertain" => "Emin değil", _ => "—" })</td>
                                <td class="small text-muted-2">@(firm.Quote is null ? "—" : "«" + firm.Quote + "»")</td>
                                <td class="text-end text-nowrap">
                                    <form asp-action="Label" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="domain" value="@d" />
                                        <button name="label" value="producer" class="btn btn-sm @(isFound ? "btn-success" : "btn-outline-success")">Üretici</button>
                                        <button name="label" value="not" class="btn btn-sm @(isWrong ? "btn-danger" : "btn-outline-danger")">Değil</button>
                                        @if (isFound || isWrong)
                                        {
                                            <button name="label" value="clear" class="btn btn-sm btn-outline-secondary" title="Etiketi kaldır">×</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            <details class="mt-3">
                <summary>Bu kalemi düzenle</summary>
                <form asp-action="SaveItem" method="post" class="mt-2">
                    <input type="hidden" name="id" value="@item.Id" />
                    <partial name="_QualityItemFields" model="item" />
                    <button type="submit" class="btn btn-outline-primary btn-sm mt-2">Kaydet</button>
                </form>
            </details>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">Yeni ölçü seti kalemi</div>
    <div class="card-body">
        <form asp-action="SaveItem" method="post">
            <partial name="_QualityItemFields" model="@(new GoldItem())" />
            <button type="submit" class="btn btn-accent btn-sm mt-2">Ekle</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var running = @(Model.Any(r => r.Run?.Running == true) ? "true" : "false");
            if (!running) return;
            var timer = setInterval(function () {
                fetch('@Url.Action("Status")', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (s) { if (!s.running) { clearInterval(timer); location.reload(); } })
                    .catch(function () { });
            }, 3000);
        })();
    </script>
}
