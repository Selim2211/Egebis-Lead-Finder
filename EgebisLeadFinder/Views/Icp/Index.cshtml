@model IcpProfile
@{
    ViewData["Title"] = "İdeal Müşteri Profili";
    var naceCounts = (Dictionary<string, int>)ViewBag.NaceCounts;
    var selected = new HashSet<string>(Model.NaceCodes);
    var sections = NaceCatalog.Divisions.GroupBy(d => (d.SectionCode, d.SectionName));
    var suggestion = ViewBag.Suggestion as EgebisLeadFinder.Services.IcpSuggestion;
}

<div class="page-head">
    <div>
        <h1>İdeal Müşteri Profili (ICP)</h1>
        <div class="page-sub">Hedef sektör (NACE), bölge ve büyüklük; firma puanları ve "ICP'ye uyanlar" filtresi buna göre çalışır</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Company" asp-action="Index" asp-route-icp="true">
        ICP'ye uyan @ViewBag.MatchCount firma →
    </a>
</div>

@if (TempData["SettingsSaved"] is string saved)
{
    <div class="alert alert-success" data-flash="success">@saved</div>
}

@if (TempData["IcpError"] is string icpError)
{
    <div class="alert alert-danger" data-flash="error">@icpError</div>
}

<div class="card mb-4 icp-suggest-card" id="icp-suggestion">
    <div class="card-header d-flex align-items-center gap-2">@Icons.Sparkles(16) Sitemizden ICP öner</div>
    <div class="card-body">
        <form method="post" asp-action="Suggest" class="d-flex flex-wrap gap-2 align-items-center"
              data-progress-start="@Url.Action("StartSuggest")"
              data-progress-title="ICP önerisi hazırlanıyor"
              data-progress-hint="Siteniz okunuyor ve yapay zekâ müşteri profilinizi çıkarıyor; öneri siz kaydedene kadar uygulanmaz.">
            @Html.AntiForgeryToken()
            <input class="form-control flex-grow-1" style="min-width:240px;max-width:420px" name="website" value="@ViewBag.Website"
                   placeholder="ör. egebis.com" required />
            <button type="submit" class="btn btn-accent">Siteyi analiz et</button>
            <span class="small text-muted-2">Yapay zekâ sitenizdeki ürün ve hizmetlere bakıp müşterilerinizin profilini önerir. Öneri siz kaydedene kadar uygulanmaz.</span>
        </form>

        @if (suggestion is not null)
        {
            <hr />
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                <div>
                    <div class="fw-semibold">Öneri: @suggestion.Website</div>
                    <div class="small text-muted-2">@suggestion.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @suggestion.CompanySummary</div>
                </div>
                <div class="d-flex gap-2 align-items-start">
                    <button type="button" class="btn btn-sm btn-accent" data-icp-apply="merge" title="Listeleri mevcut değerlerle birleştirir">Forma ekle</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-icp-apply="replace" title="Formdaki değerleri öneriyle değiştirir">Formu öneriyle değiştir</button>
                    <form method="post" asp-action="DismissSuggestion" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link text-muted-2">Kapat</button>
                    </form>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(suggestion.IdealCustomer))
            {
                <p class="mb-3"><span class="fw-semibold">İdeal müşteri:</span> @suggestion.IdealCustomer</p>
            }
            <div class="icp-suggest-grid">
                <div>
                    <h3>Hedef sektörler (NACE)</h3>
                    <ul>
                        @foreach (var n in suggestion.Nace)
                        {
                            <li><span class="nace-code">@n.Code</span> @n.Name<span class="d-block small text-muted-2">@n.Reason</span></li>
                        }
                    </ul>
                </div>
                <div>
                    <h3>Sektör kelimeleri</h3>
                    <p>@string.Join(", ", suggestion.IndustryKeywords)</p>
                    <h3>Bölge</h3>
                    <p class="mb-1">@string.Join(", ", suggestion.Countries.Concat(suggestion.Cities).DefaultIfEmpty("Şart yok"))</p>
                    <p class="small text-muted-2">@suggestion.LocationReason</p>
                </div>
                <div>
                    <h3>Ölçek ve tür</h3>
                    <p class="mb-1">Asgari çalışan: <strong>@(suggestion.MinEmployees > 0 ? suggestion.MinEmployees.ToString() : "şart yok")</strong></p>
                    <p class="small text-muted-2">@suggestion.MinEmployeesReason</p>
                    <p class="mb-1">Yalnızca üretici: <strong>@(suggestion.RequireManufacturer ? "Evet" : "Hayır")</strong></p>
                    <p class="small text-muted-2">@suggestion.ManufacturerReason</p>
                </div>
                <div>
                    <h3>Hariç tutulacaklar</h3>
                    <p class="mb-1">@string.Join(", ", suggestion.ExcludeKeywords)</p>
                    <p class="small text-muted-2">@suggestion.ExcludeReason</p>
                    @if (suggestion.TargetTitles.Count > 0)
                    {
                        <h3>Ulaşılacak unvanlar</h3>
                        <p class="mb-1">@string.Join(", ", suggestion.TargetTitles)</p>
                        <p class="small text-muted-2">Unvanlar ICP'nin parçası değil; <a asp-controller="BusinessProfile" asp-action="Index">Biz ne arıyoruz?</a> ekranındaki hedef unvanlara ekleyebilirsiniz.</p>
                    }
                </div>
            </div>
            <script type="application/json" id="icpSuggestionData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                nace = suggestion.DivisionCodes,
                industries = suggestion.IndustryKeywords,
                cities = suggestion.Cities,
                countries = suggestion.Countries,
                minEmployees = suggestion.MinEmployees,
                requireManufacturer = suggestion.RequireManufacturer,
                exclude = suggestion.ExcludeKeywords
            }))</script>
        }
    </div>
</div>

<form id="fillNaceForm" method="post" asp-action="StartFillNace" class="d-none"
      data-progress-start="@Url.Action("StartFillNace")"
      data-progress-title="NACE kodları belirleniyor"
      data-progress-hint="Kayıtlı firma analizlerinden yapay zeka NACE kodu atıyor; siteler yeniden taranmaz, puanlar değişmez.">
    @Html.AntiForgeryToken()
</form>

<form method="post" id="icpForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">Hedef sektörler (NACE Rev.2)</div>
                <div class="card-body">
                    @if (ViewBag.MissingNace is int missing && missing > 0)
                    {
                        <div class="alert alert-secondary small d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <span>@missing firmanın NACE kodu yok; bu firmalar "ICP'ye uyanlar" listesine giremez.</span>
                            <button type="submit" form="fillNaceForm" class="btn btn-sm btn-primary">NACE kodlarını doldur</button>
                        </div>
                    }
                    <div class="small text-muted-2 mb-3">
                        Seçilen bölümlerdeki firmalar "hedef sektör" puanı alır. Firmanın NACE kodunu yapay zeka
                        site analizinde belirler; eski firmalarda boşsa firma sayfasındaki "Yeniden Analiz Et" ile dolar.
                    </div>
                    @foreach (var sec in sections)
                    {
                        var open = sec.Key.SectionCode == "C" || sec.Any(d => selected.Contains(d.Code));
                        <details class="icp-section" open="@open">
                            <summary>
                                <strong>@sec.Key.SectionCode</strong> · @sec.Key.SectionName
                                <span class="cell-sub">(@sec.Count(d => selected.Contains(d.Code)) seçili)</span>
                            </summary>
                            <div class="icp-grid">
                                @foreach (var d in sec)
                                {
                                    <label class="icp-option">
                                        <input type="checkbox" name="nace" value="@d.Code" checked="@selected.Contains(d.Code)" />
                                        <span><strong>@d.Code</strong> @d.Name</span>
                                        @if (naceCounts.TryGetValue(d.Code, out var n))
                                        {
                                            <span class="tag tag-muted">@n</span>
                                        }
                                    </label>
                                }
                            </div>
                        </details>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header">Diğer kriterler</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Sektör kelimeleri</label>
                        <input class="form-control" name="industries" value="@string.Join(", ", Model.IndustryKeywords)"
                               placeholder="otomotiv, plastik, kalıp" />
                        <div class="form-text">NACE kodu olmayan firmalarda sektör metninde aranır. Virgülle ayırın.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef iller</label>
                        <input class="form-control" name="cities" list="provinceList" value="@string.Join(", ", Model.Cities)"
                               placeholder="Bursa, Kocaeli, Manisa" />
                        <datalist id="provinceList">
                            @foreach (var p in TurkishProvinces.All)
                            {
                                <option value="@p"></option>
                            }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef ülkeler</label>
                        <input class="form-control" name="countries" value="@string.Join(", ", Model.Countries)"
                               placeholder="Türkiye, Almanya" />
                        <div class="form-text">İl veya ülkeden biri tutarsa "hedef bölge" sayılır.</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Asgari çalışan</label>
                            <input class="form-control" type="number" min="0" name="minEmployees" value="@Model.MinEmployees" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Bölge puanı</label>
                            <input class="form-control" type="number" min="0" max="30" name="locationWeight" value="@Model.LocationWeight" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="requireManufacturer" value="true" id="reqMan" checked="@Model.RequireManufacturer" />
                        <input type="hidden" name="requireManufacturer" value="false" />
                        <label class="form-check-label" for="reqMan">Yalnızca üretici firmalar ICP'ye uysun</label>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Hariç tutulacak kelimeler</label>
                        <input class="form-control" name="exclude" value="@string.Join(", ", Model.ExcludeKeywords)"
                               placeholder="bayi, distribütör, ithalatçı" />
                        <div class="form-text">Firma adı, sektör veya ürünlerde geçerse firma elenir (puan 0).</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-accent" name="rescore" value="true">Kaydet ve firmaları yeniden puanla</button>
                <button class="btn btn-outline-secondary" name="rescore" value="false">Sadece kaydet</button>
            </div>
            <div class="form-text mt-2">Yeniden puanlama kayıtlı analizleri kullanır; API kredisi harcamaz.</div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        var data = document.getElementById('icpSuggestionData');
        if (!data) return;
        var s = JSON.parse(data.textContent);
        var form = document.getElementById('icpForm');

        function split(v) { return (v || '').split(/[,;\n]/).map(function (x) { return x.trim(); }).filter(Boolean); }
        function setList(name, values, merge) {
            var input = form.querySelector('[name="' + name + '"]');
            var list = merge ? split(input.value) : [];
            values.forEach(function (v) {
                if (!list.some(function (x) { return x.toLocaleLowerCase('tr') === v.toLocaleLowerCase('tr'); })) list.push(v);
            });
            input.value = list.join(', ');
            input.classList.add('icp-filled');
        }

        document.querySelectorAll('[data-icp-apply]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var merge = btn.getAttribute('data-icp-apply') === 'merge';
                form.querySelectorAll('input[name="nace"]').forEach(function (cb) {
                    var on = s.nace.indexOf(cb.value) !== -1;
                    if (on || !merge) cb.checked = on || (merge && cb.checked);
                    if (on) { var d = cb.closest('details'); if (d) d.open = true; cb.closest('label').classList.add('icp-filled'); }
                });
                setList('industries', s.industries, merge);
                setList('cities', s.cities, merge);
                setList('countries', s.countries, merge);
                setList('exclude', s.exclude, merge);
                var min = form.querySelector('[name="minEmployees"]');
                if (!merge || s.minEmployees > 0) { min.value = s.minEmployees; min.classList.add('icp-filled'); }
                document.getElementById('reqMan').checked = s.requireManufacturer;
                if (window.egToast) egToast.success('Öneri forma uygulandı. Kontrol edip "Kaydet" ile kaydedin.');
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    })();
</script>
}
