@model UserSpendViewModel
@using System.Globalization
@using EgebisLeadFinder.Services
@{
    ViewData["Title"] = "Kullanıcı API Harcaması";
    var tr = new CultureInfo("tr-TR");
    var maxSerper = Math.Max(1, Model.Users.Select(u => u.Serper).DefaultIfEmpty(0).Max());
    var maxAi = Math.Max(1, Model.Users.Select(u => u.AiCalls).DefaultIfEmpty(0).Max());
    string N(int n) => n.ToString("N0", tr);
    double Pct(int v, int max) => Math.Round(100.0 * v / max, 1);
}

<div class="page-head">
    <div>
        <h1>Kullanıcı API Harcaması</h1>
        <div class="page-sub">Kim ne kadar Serper kredisi ve yapay zekâ çağrısı harcadı. Bir kullanıcıya tıklayarak harcama profilini görün.</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Usage" asp-action="Credits">Kullanılan Krediler</a>
        <a class="btn btn-outline-secondary" asp-controller="Usage" asp-action="Index">API Kullanımı</a>
    </div>
</div>

<partial name="_SpendPeriodBar" model="Model" />

<div class="row g-3 mb-3 text-center">
    <div class="col-4"><div class="card h-100"><div class="card-body">
        <div class="stat-label">Arama</div>
        <div class="stat-value" style="font-size:1.8rem">@N(Model.Users.Sum(u => u.Searches))</div>
        <div class="cell-sub">yapılan arama</div>
    </div></div></div>
    <div class="col-4"><div class="card h-100"><div class="card-body">
        <div class="stat-label">Serper</div>
        <div class="stat-value" style="font-size:1.8rem">@N(Model.Users.Sum(u => u.Serper))</div>
        <div class="cell-sub">kredi (Google arama)</div>
    </div></div></div>
    <div class="col-4"><div class="card h-100"><div class="card-body">
        <div class="stat-label">Yapay zekâ</div>
        <div class="stat-value" style="font-size:1.8rem">@N(Model.Users.Sum(u => u.AiCalls))</div>
        <div class="cell-sub">çağrı</div>
    </div></div></div>
</div>

@if (Model.Users.Count == 0)
{
    <div class="card"><div class="card-body text-muted-2">Bu dönemde arama yapılmadı.</div></div>
    return;
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>Kullanıcıya göre harcama</span>
        <span class="chart-legend">
            <span class="legend-dot" style="background:#2563eb"></span> Serper (kredi)
            <span class="legend-dot" style="background:#7c3aed"></span> Yapay zekâ (çağrı)
        </span>
    </div>
    <div class="card-body">
        @foreach (var u in Model.Users)
        {
            <a class="d-block text-decoration-none mb-3 spend-user" asp-action="UserProfile" asp-route-id="@u.UserId"
               asp-route-period="@Model.Period.Kind" asp-route-date="@Model.Period.From.ToString("yyyy-MM-dd")">
                <div class="d-flex justify-content-between small mb-1">
                    <strong>@u.UserName</strong>
                    <span class="text-muted-2">@N(u.Searches) arama</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="flex-grow-1 spend-track"><div class="spend-bar" style="width:@Pct(u.Serper, maxSerper).ToString("0.#", CultureInfo.InvariantCulture)%;background:#2563eb"></div></div>
                    <span class="small spend-num">@N(u.Serper)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="flex-grow-1 spend-track"><div class="spend-bar" style="width:@Pct(u.AiCalls, maxAi).ToString("0.#", CultureInfo.InvariantCulture)%;background:#7c3aed"></div></div>
                    <span class="small spend-num">@N(u.AiCalls)</span>
                </div>
            </a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Özet tablo</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th class="text-end">Arama</th>
                    <th class="text-end">Serper (kredi)</th>
                    <th class="text-end">Yapay zekâ (çağrı)</th>
                    <th>Son arama</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td><a asp-action="UserProfile" asp-route-id="@u.UserId" asp-route-period="@Model.Period.Kind" asp-route-date="@Model.Period.From.ToString("yyyy-MM-dd")">@u.UserName</a></td>
                    <td class="text-end">@N(u.Searches)</td>
                    <td class="text-end">@N(u.Serper)</td>
                    <td class="text-end">@N(u.AiCalls)</td>
                    <td class="small text-muted-2">@(u.LastAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="small text-muted-2 mb-4">
    Bu sayfa aramalarla birlikte kaydedilen Serper ve yapay zekâ harcamasını gösterir. Apollo e-posta açma ve günlük Gemini token toplamı kullanıcıya bağlı tutulmaz;
    onlar için "Kullanılan Krediler" sayfasına bakın.
</div>

<style>
    .spend-track { background: var(--bs-tertiary-bg, #eef1f5); border-radius: 999px; height: .6rem; overflow: hidden; }
    .spend-bar { height: 100%; border-radius: 999px; min-width: 2px; transition: width .3s ease; }
    .spend-num { min-width: 3.5rem; text-align: right; font-variant-numeric: tabular-nums; }
    .spend-user:hover strong { text-decoration: underline; }
</style>
