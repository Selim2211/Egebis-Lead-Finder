@model CreditsViewModel
@using System.Globalization
@using EgebisLeadFinder.Services
@{
    ViewData["Title"] = "Kullanılan Krediler";
    var report = Model.Report;
    var p = report.Period;
    var tr = new CultureInfo("tr-TR");
    var anchor = p.From.ToString("yyyy-MM-dd");

    string PeriodUrl(string kind, DateOnly date) => Context.Request.PathBase + "/Usage/Credits?period=" + kind + "&date=" + date.ToString("yyyy-MM-dd");
    string Num(int n) => n == 0 ? "—" : n.ToString("N0", tr);
    string Tl(decimal v) => v == 0 ? "—" : "≈ " + v.ToString("N2", tr) + " TL";

    var runSerper = Model.Runs.Sum(r => r.SerperCredits);
    var runAi = Model.Runs.Sum(r => r.AiCalls);
}

<div class="page-head">
    <div>
        <h1>Kullanılan Krediler</h1>
        <div class="page-sub">Serper, Apollo ve Gemini'de günlük, haftalık ve aylık ne harcandı</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Usage" asp-action="Users">Kullanıcı Harcaması</a>
        <a class="btn btn-outline-secondary" asp-controller="Usage" asp-action="Index">API Kullanımı</a>
        <a class="btn btn-outline-secondary" asp-controller="Settings" asp-action="Index">Ayarlar</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="btn-group" role="group" aria-label="Dönem">
            <a class="btn btn-sm @(p.Kind == CreditsPeriod.Day ? "btn-accent" : "btn-outline-secondary")" href="@PeriodUrl(CreditsPeriod.Day, p.From)">Gün</a>
            <a class="btn btn-sm @(p.Kind == CreditsPeriod.Week ? "btn-accent" : "btn-outline-secondary")" href="@PeriodUrl(CreditsPeriod.Week, p.From)">Hafta</a>
            <a class="btn btn-sm @(p.Kind == CreditsPeriod.Month ? "btn-accent" : "btn-outline-secondary")" href="@PeriodUrl(CreditsPeriod.Month, p.From)">Ay</a>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="@PeriodUrl(p.Kind, p.Prev)" aria-label="Önceki dönem" title="Önceki">‹</a>
            <strong class="credits-label">@p.Label</strong>
            <a class="btn btn-sm btn-outline-secondary" href="@PeriodUrl(p.Kind, p.Next)" aria-label="Sonraki dönem" title="Sonraki">›</a>
        </div>

        <form method="get" class="d-flex align-items-center gap-2 ms-lg-auto m-0" id="creditsDateForm">
            <input type="hidden" name="period" value="@p.Kind" />
            <label class="small text-muted-2 mb-0" for="creditsDate">Tarih seç</label>
            <input type="date" class="form-control form-control-sm" id="creditsDate" name="date" value="@anchor" max="@UsageService.Today.ToString("yyyy-MM-dd")" />
            <a class="btn btn-sm btn-outline-secondary" href="@PeriodUrl(p.Kind, UsageService.Today)">Bugün</a>
        </form>
    </div>
</div>

<div class="row g-3 mb-3 text-center">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="stat-label">Serper</div>
            <div class="stat-value" style="font-size:1.8rem">@Num(report.Serper)</div>
            <div class="cell-sub">kredi (Google arama)</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="stat-label">Apollo</div>
            <div class="stat-value" style="font-size:1.8rem">@Num(report.Apollo)</div>
            <div class="cell-sub">kredi (e-posta açma)</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="stat-label">Gemini</div>
            <div class="stat-value" style="font-size:1.8rem">@Num(report.Gemini)</div>
            <div class="cell-sub">çağrı · @Tl(report.GeminiTry)</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="stat-label">Diğer yapay zekâ</div>
            <div class="stat-value" style="font-size:1.8rem">@Num(report.OtherAi)</div>
            <div class="cell-sub">çağrı (Groq / NVIDIA, ücretsiz)</div>
        </div></div>
    </div>
</div>

<div class="small text-muted-2 mb-3">
    TL tutarları gerçek fatura değil, tahmindir: Gemini çağrı sayısı × çağrı başına tahmini ücret (dolar), güncel dolar kuruyla Türk lirasına çevrilir.
    Serper ve Apollo kredi olarak gösterilir, TL karşılığı hesaplanmaz.
</div>

<div class="card mb-4">
    <div class="card-header">Gün gün harcama</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" id="creditsDays">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th class="text-end">Serper (kredi)</th>
                    <th class="text-end">Apollo (kredi)</th>
                    <th class="text-end">Gemini (çağrı)</th>
                    <th class="text-end">Gemini tahmini maliyet (TL)</th>
                    <th class="text-end">Diğer yapay zekâ (çağrı)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in report.Days)
            {
                <tr class="@(d.IsEmpty ? "text-muted-2" : "")">
                    <td><a href="@PeriodUrl(CreditsPeriod.Day, d.Date)">@d.Date.ToString("dd.MM.yyyy dddd", tr)</a></td>
                    <td class="text-end">@Num(d.Serper)</td>
                    <td class="text-end">@Num(d.Apollo)</td>
                    <td class="text-end">@Num(d.Gemini)</td>
                    <td class="text-end">@(d.GeminiTry == 0 ? "—" : d.GeminiTry.ToString("N2", tr))</td>
                    <td class="text-end">@Num(d.OtherAi)</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td>Toplam (@p.Label)</td>
                    <td class="text-end">@report.Serper.ToString("N0", tr)</td>
                    <td class="text-end">@report.Apollo.ToString("N0", tr)</td>
                    <td class="text-end">@report.Gemini.ToString("N0", tr)</td>
                    <td class="text-end">@report.GeminiTry.ToString("N2", tr)</td>
                    <td class="text-end">@report.OtherAi.ToString("N0", tr)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Bu dönemdeki aramalar ve harcadıkları</div>
    @if (Model.Runs.Count == 0)
    {
        <div class="card-body text-muted-2">Bu dönemde arama yapılmadı.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="creditsRuns">
                <thead>
                    <tr>
                        <th>Zaman</th>
                        <th>Kullanıcı</th>
                        <th>Arama</th>
                        <th class="text-end">Bulunan</th>
                        <th class="text-end">Serper (kredi)</th>
                        <th class="text-end">Yapay zekâ (çağrı)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr>
                        <td class="text-nowrap">@r.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", tr)</td>
                        <td>@(r.User?.DisplayName ?? "—")</td>
                        <td>
                            @r.Describe()
                            @if (r.Status != SearchRunStatus.Done)
                            {
                                <span class="text-muted-2 small"> · @r.StatusLabel(DateTime.UtcNow)</span>
                            }
                        </td>
                        <td class="text-end">@r.Found</td>
                        <td class="text-end">@Num(r.SerperCredits)</td>
                        <td class="text-end">@Num(r.AiCalls)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="4">Aramaların toplamı</td>
                        <td class="text-end">@runSerper.ToString("N0", tr)</td>
                        <td class="text-end">@runAi.ToString("N0", tr)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

<p class="small text-muted-2">
    Sayaçlar uygulamanın yaptığı çağrılardan hesaplanır; Serper ve Google bakiye sorgulama sunmaz. Önbellekten dönen aramalar kredi harcamaz.
    Gemini maliyeti, Gemini'nin bildirdiği gerçek token sayılarından hesaplanan tahmindir, fatura değildir.
    Aramalara özel sayaç bu özellikten sonra yapılan aramalarda dolar; önceki aramalarda "—" görünür.
    Gün, Türkiye saatine (UTC+3) göredir; hafta Pazartesi başlar. Aramaların toplamı, tabloda görünmeyen diğer işleri (firma araştırması, lead bulma, e-posta) içermez.
</p>

@section Scripts {
<script>
    // Tarih secilince donem o gunu iceren gun/hafta/ay olarak yenilenir.
    document.getElementById('creditsDate').addEventListener('change', function () {
        if (this.value) document.getElementById('creditsDateForm').submit();
    });
</script>
}
