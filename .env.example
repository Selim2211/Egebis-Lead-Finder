# Bu dosyayi .env olarak kopyalayin ve degerleri degistirin. .env git'e gonderilmez.
POSTGRES_DB=egebisleadfinder
POSTGRES_USER=egebis
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN

# Uygulamanin sunucuda dinleyecegi port
APP_PORT=8091

# Kritik alan sifreleme anahtari (base64, 32 bayt). Bos birakilirsa uygulama ilk acilista
# uretir ve appkeys volume'unda saklar. Yerel veriyi tasiyorsaniz yerel anahtari buraya yazin.
ENCRYPTION_KEY=
