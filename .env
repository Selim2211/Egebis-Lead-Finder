# Egebis Lead Finder — docker compose ayarlari
# Bu dosyayi sunucuda docker-compose.yml ile ayni klasore koyun.
# Canliya cikarken POSTGRES_PASSWORD degerini guclu bir sifreyle degistirin.
POSTGRES_DB=egebisleadfinder
POSTGRES_USER=egebis
POSTGRES_PASSWORD=egebis_dev

# Uygulamanin sunucuda dinleyecegi port
APP_PORT=8091
